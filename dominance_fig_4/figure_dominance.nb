                 RowBox[{"Style", "[", 
                  RowBox[{"\"\<fix\>\"", ",", "Italic"}], "]"}], ",", 
                 "\"\<*\>\""}], "]"}], "//", "DisplayForm"}], ",", 
              RowBox[{"Style", "[", 
               RowBox[{"\"\<) / \>\"", ",", "Italic"}], "]"}], ",", 
              RowBox[{
               RowBox[{"SubscriptBox", "[", 
                RowBox[{
                 RowBox[{"Style", "[", 
                  RowBox[{"\"\<f\>\"", ",", "Italic"}], "]"}], ",", 
                 "\"\<\!\(\*StyleBox[\"neu\",FontSlant->\"Italic\"]\)\>\""}], 
                "]"}], "//", "DisplayForm"}], ",", 
              RowBox[{"Style", "[", 
               RowBox[{"\"\<(x)\>\"", ",", "Italic"}], "]"}]}], "}"}], "]"}], 
           "]"}]}], "}"}]}], ",", 
       RowBox[{"FrameStyle", "->", 
        RowBox[{"Thickness", "[", ".003", "]"}]}], ",", 
