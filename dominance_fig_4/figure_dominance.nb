          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"D", "[", 
              RowBox[{
               RowBox[{"x2a", "[", "t", "]"}], ",", "t"}], "]"}], "==", 
             RowBox[{"s", "*", 
              RowBox[{"x2a", "[", "t", "]"}], "*", 
              RowBox[{"(", 
