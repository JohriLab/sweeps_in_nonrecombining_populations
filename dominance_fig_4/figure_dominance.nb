        RowBox[{"10", "^", "logBinEdges"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Initialize", " ", "bins"}], "*)"}], 
       RowBox[{"binnedX", "=", 
        RowBox[{"Table", "[", 
         RowBox[{"0", ",", 
          RowBox[{"{", "numBins", "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"binnedY", "=", 
        RowBox[{"Table", "[", 
         RowBox[{"0", ",", 
          RowBox[{"{", "numBins", "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"counts", "=", 
        RowBox[{"Table", "[", 
         RowBox[{"0", ",", 
          RowBox[{"{", "numBins", "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Bin", " ", "the", " ", "data"}], "*)"}], 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", "binIndex", "}"}], ",", 
           RowBox[{
            RowBox[{"binIndex", "=", 
             RowBox[{
              RowBox[{"Floor", "[", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"Log10", "[", 
                   RowBox[{"filteredData", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "1"}], "]"}], "]"}], "]"}], "-", 
                  "logMin"}], ")"}], "/", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"logMax", "-", "logMin"}], ")"}], "/", "numBins"}],
                  ")"}]}], "]"}], "+", "1"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"binIndex", ">", "0"}], "&&", 
               RowBox[{"binIndex", "<=", "numBins"}]}], ",", 
              RowBox[{
               RowBox[{
                RowBox[{"binnedX", "[", 
                 RowBox[{"[", "binIndex", "]"}], "]"}], "+=", 
                RowBox[{"filteredData", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", ",", "1"}], "]"}], "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"binnedY", "[", 
                 RowBox[{"[", "binIndex", "]"}], "]"}], "+=", 
                RowBox[{"filteredData", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", ",", "2"}], "]"}], "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"counts", "[", 
                 RowBox[{"[", "binIndex", "]"}], "]"}], "+=", "1"}], ";"}]}], 
             "]"}]}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"Length", "[", "filteredData", "]"}]}], "}"}]}], "]"}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "Calculate", " ", "mean", " ", "values", " ", "for", " ", "each", " ",
          "bin"}], "*)"}], 
       RowBox[{"binnedData", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"counts", "[", 
              RowBox[{"[", "i", "]"}], "]"}], ">", "0"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"binnedX", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "/", 
               RowBox[{"counts", "[", 
                RowBox[{"[", "i", "]"}], "]"}]}], ",", 
              RowBox[{
               RowBox[{"binnedY", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "/", 
               RowBox[{"counts", "[", 
                RowBox[{"[", "i", "]"}], "]"}]}]}], "}"}], ",", "Nothing"}], 
           "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "numBins"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Return", " ", "the", " ", "smoothed", " ", "data"}], "*)"}], 
       "binnedData"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Apply", " ", "the", " ", "smoothing", " ", "function", " ", "to", " ", 
    "your", " ", "data"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"numBins", "=", "100"}], ";", 
   RowBox[{"(*", 
    RowBox[{
    "Adjust", " ", "the", " ", "number", " ", "of", " ", "bins", " ", "as", 
     " ", "needed"}], "*)"}], 
   RowBox[{"xThreshold", "=", "0.005"}], ";", 
   RowBox[{"(*", 
    RowBox[{"Threshold", " ", "for", " ", "binning"}], "*)"}], 
   RowBox[{"smoothedData", "=", 
    RowBox[{"smoothDataLog", "[", 
     RowBox[{"Data1sh5", ",", "numBins", ",", "xThreshold"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{"Separate", " ", "data", " ", "into", " ", "two", " ", 
    RowBox[{"parts", ":", 
     RowBox[{"original", " ", "part", " ", 
      RowBox[{"(", 
       RowBox[{"x", "<=", "0.5"}], ")"}], " ", "and", " ", "smoothed", " ", 
      "part", " ", 
      RowBox[{"(", 
       RowBox[{"x", ">", "0.5"}], ")"}]}]}]}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"originalPart", "=", 
   RowBox[{"Select", "[", 
    RowBox[{"Data1sh5", ",", 
     RowBox[{
      RowBox[{
       RowBox[{"#", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "<=", "xThreshold"}], "&"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"smoothedPart", "=", 
    RowBox[{"Select", "[", 
     RowBox[{"smoothedData", ",", 
      RowBox[{
       RowBox[{
        RowBox[{"#", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ">", "xThreshold"}], "&"}]}], 
     "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Combine", " ", "original", " ", "and", " ", "smoothed", " ", "parts"}], 
   "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"combinedData", "=", 
    RowBox[{"Join", "[", 
     RowBox[{"originalPart", ",", "smoothedPart"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Plot", " ", "the", " ", "original", " ", "and", " ", "combined", " ", 
    "data"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"a1sOriginal", "=", 
    RowBox[{"ListLogLogPlot", "[", 
     RowBox[{
      RowBox[{"{", "Data1sh5", "}"}], ",", 
      RowBox[{"Frame", "->", "True"}], ",", 
      RowBox[{"FrameLabel", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<x\>\"", ",", "\"\<Distribution of SFS\>\""}], "}"}]}], 
      ",", 
      RowBox[{"FrameStyle", "->", 
       RowBox[{"Thickness", "[", ".003", "]"}]}], ",", 
      RowBox[{"FrameTicks", "->", "Automatic"}], ",", 
      RowBox[{"LabelStyle", "->", 
       RowBox[{"Directive", "[", 
        RowBox[{"Black", ",", "Bold", ",", "Medium"}], "]"}]}], ",", 
      RowBox[{"PlotStyle", "->", 
       RowBox[{"{", "Blue", "}"}]}], ",", 
      RowBox[{"PlotLegends", "->", 
       RowBox[{"{", "\"\<Original Data\>\"", "}"}]}], ",", 
      RowBox[{"PlotRange", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0.001", ",", "1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"0.01", ",", "10000"}], "}"}]}], "}"}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"a1sCombined", "=", 
    RowBox[{"ListLogLogPlot", "[", 
     RowBox[{
      RowBox[{"{", "combinedData", "}"}], ",", 
      RowBox[{"Frame", "->", "True"}], ",", 
      RowBox[{"FrameLabel", "->", 
       RowBox[{"{", 
        StyleBox[
         RowBox[{
         "\"\<x\>\"", ",", 
          "\"\<f(x,\!\(\*SubscriptBox[\(t\), \
\(fix\)]\))/\!\(\*SubscriptBox[\(f\), \(neu\)]\)\>\""}],
         FontSlant->"Italic"], "}"}]}], ",", 
      RowBox[{"FrameStyle", "->", 
       RowBox[{"Thickness", "[", ".003", "]"}]}], ",", 
      RowBox[{"FrameTicks", "->", "Automatic"}], ",", 
      RowBox[{"LabelStyle", "->", 
       RowBox[{"Directive", "[", 
        RowBox[{"Black", ",", "Bold", ",", "Medium"}], "]"}]}], ",", 
      RowBox[{"PlotStyle", "->", 
       RowBox[{"{", "Blue", "}"}]}], ",", 
      RowBox[{"PlotLegends", "->", 
       RowBox[{"{", "\"\<h=0.5\>\"", "}"}]}], ",", 
      RowBox[{"PlotRange", "->", "All"}], ",", " ", 
      RowBox[{"PlotMarkers", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"\"\<\[FilledCircle]\>\"", ",", "10"}], "}"}]}]}], "]"}]}], 
   ";"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{"Show", " ", "both", " ", "plots"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", "a1sCombined", "]"}], "\[IndentingNewLine]"}], "Input",
