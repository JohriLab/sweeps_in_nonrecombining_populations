       RowBox[{"Total", "[", 
        RowBox[{"Drop", "[", 
         RowBox[{"list04", ",", "8"}], "]"}], "]"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
