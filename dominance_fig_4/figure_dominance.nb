Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"normalizeList", "[", "lst_", "]"}], ":=", 
   RowBox[{"lst", "/", 
    RowBox[{"Total", "[", "lst", "]"}]}]}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"list01Normalized", "=", 
   RowBox[{"normalizeList", "[", "sumList01", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"list02Normalized", "=", 
   RowBox[{"normalizeList", "[", "sumList02", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"list03Normalized", "=", 
    RowBox[{"normalizeList", "[", "sumList03", "]"}]}], ";"}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", "BarChart", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"barchart", "=", 
    RowBox[{"BarChart", "[", 
     RowBox[{
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{
        "list01Normalized", ",", "list02Normalized", ",", 
         "list03Normalized"}], "}"}], "]"}], ",", 
      RowBox[{"ChartStyle", "->", 
       RowBox[{"{", 
        RowBox[{"Magenta", ",", "Blue", ",", "Red"}], "}"}]}], ",", 
