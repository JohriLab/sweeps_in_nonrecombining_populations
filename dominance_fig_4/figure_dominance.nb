Cell[CellGroupData[{

Cell["\<\

Ns = 10\
\>", "Subsection",
 CellChangeTimes->{{3.931973316025219*^9, 3.931973317524769*^9}, 
   3.932724780133881*^9},ExpressionUUID->"db2d9c07-2434-4b76-bff4-\
