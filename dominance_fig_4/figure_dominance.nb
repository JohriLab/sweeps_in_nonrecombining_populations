Cell[CellGroupData[{

Cell["\<\

Sample SFS for dominance case\
\>", "Section",
 CellChangeTimes->{{3.930323350347423*^9, 
  3.930323365179111*^9}},ExpressionUUID->"26bbb8c1-05ea-4565-886c-\
dc4bcccaab72"],

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{"Quit", "[", "]"}]}]], "Input",
 CellChangeTimes->{{3.930323449283861*^9, 3.930323450493903*^9}},
 CellLabel->
  "In[115]:=",ExpressionUUID->"6d0f6833-9ff8-4417-9b95-2e1e98db7ece"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"N1", "=", "1000"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"mu", "=", 
   RowBox[{"10", "^", 
    RowBox[{"-", "7"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"L", "=", "99999"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"theta", "=", 
   RowBox[{"4", " ", "N1", " ", "mu", " ", "L"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Read", " ", "the", " ", "data"}], "*)"}], 
  RowBox[{
   RowBox[{"s1sh2", "=", 
    RowBox[{
    "OpenRead", "[", 
     "\"\</Users/user/Desktop/Slim_programs/Sel_sfs_independent/Sweeps_\
project/hard_sweep/post_fix_h_0.2_more_loci.txt\>\"", "]"}]}], 
   ";"}]}], "\n", 
 RowBox[{
  RowBox[{"datas1sh2", "=", 
   RowBox[{"ReadList", "[", 
    RowBox[{"s1sh2", ",", 
     RowBox[{"{", 
      RowBox[{"Number", ",", "Number"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Close", "[", "s1sh2", "]"}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"x11sh2", "=", 
   RowBox[{"datas1sh2", "[", 
    RowBox[{"[", 
     RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"x21sh2", "=", 
    RowBox[{"datas1sh2", "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Data1sh2", "=", 
    RowBox[{"Transpose", "@", 
     RowBox[{"{", 
      RowBox[{"x11sh2", ",", " ", "x21sh2"}], "}"}]}]}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
   "Define", " ", "logarithmic", " ", "binning", " ", "and", " ", "smoothing",
     " ", "function"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"smoothDataLog", "[", 
     RowBox[{"data_", ",", "numBins_", ",", "xThreshold_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "filteredData", ",", "bins", ",", "binnedData", ",", "binEdges", ",", 
        "binnedX", ",", "binnedY", ",", "counts", ",", "logMin", ",", 
        "logMax", ",", "logBinEdges"}], "}"}], ",", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
        "Filter", " ", "data", " ", "to", " ", "include", " ", "only", " ", 
         "points", " ", "where", " ", "x"}], ">", "xThreshold"}], "*)"}], 
      RowBox[{
       RowBox[{"filteredData", "=", 
        RowBox[{"Select", "[", 
         RowBox[{"data", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ">", "xThreshold"}], "&"}]}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "Determine", " ", "the", " ", "range", " ", "and", " ", "width", " ", 
         "of", " ", "bins", " ", "for", " ", "filtered", " ", "data"}], 
        "*)"}], 
       RowBox[{"logMin", "=", 
        RowBox[{"Log10", "[", 
         RowBox[{"Min", "[", 
          RowBox[{"filteredData", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"logMax", "=", 
        RowBox[{"Log10", "[", 
         RowBox[{"Max", "[", 
          RowBox[{"filteredData", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"logBinEdges", "=", 
        RowBox[{"Range", "[", 
         RowBox[{"logMin", ",", "logMax", ",", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"logMax", "-", "logMin"}], ")"}], "/", "numBins"}]}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"bins", "=", 
        RowBox[{"10", "^", "logBinEdges"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Initialize", " ", "bins"}], "*)"}], 
       RowBox[{"binnedX", "=", 
        RowBox[{"Table", "[", 
         RowBox[{"0", ",", 
          RowBox[{"{", "numBins", "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"binnedY", "=", 
        RowBox[{"Table", "[", 
         RowBox[{"0", ",", 
          RowBox[{"{", "numBins", "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"counts", "=", 
        RowBox[{"Table", "[", 
         RowBox[{"0", ",", 
          RowBox[{"{", "numBins", "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Bin", " ", "the", " ", "data"}], "*)"}], 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", "binIndex", "}"}], ",", 
           RowBox[{
            RowBox[{"binIndex", "=", 
             RowBox[{
              RowBox[{"Floor", "[", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"Log10", "[", 
                   RowBox[{"filteredData", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "1"}], "]"}], "]"}], "]"}], "-", 
                  "logMin"}], ")"}], "/", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"logMax", "-", "logMin"}], ")"}], "/", "numBins"}],
                  ")"}]}], "]"}], "+", "1"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"binIndex", ">", "0"}], "&&", 
               RowBox[{"binIndex", "<=", "numBins"}]}], ",", 
              RowBox[{
               RowBox[{
                RowBox[{"binnedX", "[", 
                 RowBox[{"[", "binIndex", "]"}], "]"}], "+=", 
                RowBox[{"filteredData", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", ",", "1"}], "]"}], "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"binnedY", "[", 
                 RowBox[{"[", "binIndex", "]"}], "]"}], "+=", 
                RowBox[{"filteredData", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", ",", "2"}], "]"}], "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"counts", "[", 
                 RowBox[{"[", "binIndex", "]"}], "]"}], "+=", "1"}], ";"}]}], 
             "]"}]}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"Length", "[", "filteredData", "]"}]}], "}"}]}], "]"}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "Calculate", " ", "mean", " ", "values", " ", "for", " ", "each", " ",
          "bin"}], "*)"}], 
       RowBox[{"binnedData", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"counts", "[", 
              RowBox[{"[", "i", "]"}], "]"}], ">", "0"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"binnedX", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "/", 
               RowBox[{"counts", "[", 
                RowBox[{"[", "i", "]"}], "]"}]}], ",", 
              RowBox[{
               RowBox[{"binnedY", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "/", 
               RowBox[{"counts", "[", 
                RowBox[{"[", "i", "]"}], "]"}]}]}], "}"}], ",", "Nothing"}], 
           "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "numBins"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Return", " ", "the", " ", "smoothed", " ", "data"}], "*)"}], 
       "binnedData"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Apply", " ", "the", " ", "smoothing", " ", "function", " ", "to", " ", 
    "your", " ", "data"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"numBins", "=", "100"}], ";", 
   RowBox[{"(*", 
    RowBox[{
    "Adjust", " ", "the", " ", "number", " ", "of", " ", "bins", " ", "as", 
     " ", "needed"}], "*)"}], 
   RowBox[{"xThreshold", "=", "0.005"}], ";", 
   RowBox[{"(*", 
    RowBox[{"Threshold", " ", "for", " ", "binning"}], "*)"}], 
   RowBox[{"smoothedData", "=", 
    RowBox[{"smoothDataLog", "[", 
     RowBox[{"Data1sh2", ",", "numBins", ",", "xThreshold"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{"Separate", " ", "data", " ", "into", " ", "two", " ", 
    RowBox[{"parts", ":", 
     RowBox[{"original", " ", "part", " ", 
      RowBox[{"(", 
       RowBox[{"x", "<=", "0.5"}], ")"}], " ", "and", " ", "smoothed", " ", 
      "part", " ", 
      RowBox[{"(", 
       RowBox[{"x", ">", "0.5"}], ")"}]}]}]}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"originalPart", "=", 
   RowBox[{"Select", "[", 
    RowBox[{"Data1sh2", ",", 
     RowBox[{
      RowBox[{
       RowBox[{"#", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "<=", "xThreshold"}], "&"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"smoothedPart", "=", 
    RowBox[{"Select", "[", 
     RowBox[{"smoothedData", ",", 
      RowBox[{
       RowBox[{
        RowBox[{"#", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ">", "xThreshold"}], "&"}]}], 
     "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Combine", " ", "original", " ", "and", " ", "smoothed", " ", "parts"}], 
   "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"combinedData", "=", 
    RowBox[{"Join", "[", 
     RowBox[{"originalPart", ",", "smoothedPart"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Plot", " ", "the", " ", "original", " ", "and", " ", "combined", " ", 
    "data"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"a1sOriginal", "=", 
    RowBox[{"ListLogLogPlot", "[", 
     RowBox[{
      RowBox[{"{", "Data1sh2", "}"}], ",", 
      RowBox[{"Frame", "->", "True"}], ",", 
      RowBox[{"FrameLabel", "->", 
       RowBox[{"{", 
        StyleBox[
         RowBox[{
         "\"\<x\>\"", ",", 
          "\"\<f(x,\!\(\*SubscriptBox[\(t\), \
\(fix\)]\))/\!\(\*SubscriptBox[\(f\), \(neu\)]\)\>\""}],
         FontSlant->"Italic"], "}"}]}], ",", 
      RowBox[{"FrameStyle", "->", 
       RowBox[{"Thickness", "[", ".003", "]"}]}], ",", 
      RowBox[{"FrameTicks", "->", "Automatic"}], ",", 
      RowBox[{"LabelStyle", "->", 
       RowBox[{"Directive", "[", 
        RowBox[{"Black", ",", "Bold", ",", "Medium"}], "]"}]}], ",", 
      RowBox[{"PlotStyle", "->", 
       RowBox[{"{", "Blue", "}"}]}], ",", 
      RowBox[{"PlotLegends", "->", 
       RowBox[{"{", "\"\<Original Data\>\"", "}"}]}], ",", 
      RowBox[{"PlotRange", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0.001", ",", "1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"0.01", ",", "10000"}], "}"}]}], "}"}]}]}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"a1sCombined", "=", 
    RowBox[{"ListLogLogPlot", "[", 
     RowBox[{
      RowBox[{"{", "combinedData", "}"}], ",", 
      RowBox[{"Frame", "->", "True"}], ",", 
      RowBox[{"FrameLabel", "->", 
       RowBox[{"{", 
        StyleBox[
         RowBox[{
         "\"\<x\>\"", ",", 
          "\"\<f(x,\!\(\*SubscriptBox[\(t\), \
\(fix\)]\))/\!\(\*SubscriptBox[\(f\), \(0\)]\)\>\""}],
         FontSlant->"Italic"], "}"}]}], ",", 
      RowBox[{"FrameStyle", "->", 
       RowBox[{"Thickness", "[", ".003", "]"}]}], ",", 
      RowBox[{"FrameTicks", "->", "Automatic"}], ",", 
      RowBox[{"LabelStyle", "->", 
       RowBox[{"Directive", "[", 
        RowBox[{"Black", ",", "Bold", ",", "Medium"}], "]"}]}], ",", 
      RowBox[{"PlotStyle", "->", 
       RowBox[{"{", "Magenta", "}"}]}], ",", 
      RowBox[{"PlotLegends", "->", 
       RowBox[{"{", "\"\<h=0.2\>\"", "}"}]}], ",", 
      RowBox[{"PlotRange", "->", "All"}], ",", " ", 
      RowBox[{"PlotMarkers", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"\"\<\[FilledUpTriangle]\>\"", ",", "12"}], "}"}]}]}], 
     "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Show", " ", "both", " ", "plots"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", "a1sCombined", "]"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{
  3.9303233668870783`*^9, {3.930323446617401*^9, 3.9303234919727087`*^9}, {
   3.930323668305488*^9, 3.930323715002347*^9}},
