   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"a1sInterpolated", "=", 
     RowBox[{"LogLogPlot", "[", 
      RowBox[{
       RowBox[{"interpolation", "[", "x", "]"}], ",", 
