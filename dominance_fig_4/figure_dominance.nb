Cell[BoxData[{
 RowBox[{
  RowBox[{"N1", "=", "1000"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"mu", "=", 
   RowBox[{"10", "^", 
    RowBox[{"-", "7"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"L", "=", "99999"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"theta", "=", 
   RowBox[{"4", " ", "N1", " ", "mu", " ", "L"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"N1", "=", "1000"}], ";", 
  RowBox[{"s", "=", "0.1"}], ";", 
  RowBox[{"h", "=", "0.5"}], ";", 
  RowBox[{"x0", "=", 
   RowBox[{"1", "/", 
    RowBox[{"(", 
     RowBox[{"2", " ", "2", " ", "s", " ", "h", " ", "N1"}], ")"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"x1", "=", 
   RowBox[{"NDSolveValue", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"x2a", "[", "t", "]"}], ",", "t"}], "]"}], "==", 
        RowBox[{"h", " ", "s", "*", 
         RowBox[{"x2a", "[", "t", "]"}], "*", 
         RowBox[{"(", 
          RowBox[{"1", "-", 
           RowBox[{"x2a", "[", "t", "]"}]}], ")"}]}]}], ",", 
       RowBox[{
        RowBox[{"x2a", "[", "0", "]"}], "==", "x0"}]}], "}"}], ",", "x2a", 
     ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "1000"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"tfix", "=", 
  RowBox[{
   FractionBox[
    RowBox[{"Log", "[", 
     RowBox[{"2", " ", "2", " ", "N1", " ", "s"}], "  ", "]"}], 
    RowBox[{"h", "  ", "s", " ", 
     RowBox[{"(", 
      RowBox[{"1", "-", "h"}], ")"}]}]], "+", " ", 
   FractionBox[
    RowBox[{"EulerGamma", "+", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"2", "-", " ", 
        RowBox[{"3", " ", "h"}]}], ")"}], 
      RowBox[{"Log", "[", "h", "]"}]}], " ", "+", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"3", " ", "h"}], "-", "1"}], ")"}], " ", 
      RowBox[{"Log", "[", 
       RowBox[{"1", "-", "h"}], "]"}]}]}], 
    RowBox[{"h", "  ", "s", " ", 
     RowBox[{"(", 
      RowBox[{"1", "-", "h"}], ")"}]}]]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"averageGData", "=", 
    RowBox[{"{", "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"G", "=", 
   RowBox[{"NDSolveValue", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"g", "[", 
           RowBox[{"x", ",", "t"}], "]"}], ",", "t"}], "]"}], "==", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"x", " ", 
            RowBox[{"(", 
             RowBox[{"1", "-", "x"}], ")"}]}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{"4", " ", "N1", "*", 
            RowBox[{"x1", "[", "t", "]"}]}], ")"}]}], " ", 
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"g", "[", 
            RowBox[{"x", ",", "t"}], "]"}], ",", "x", ",", "x"}], "]"}]}]}], 
       ",", 
