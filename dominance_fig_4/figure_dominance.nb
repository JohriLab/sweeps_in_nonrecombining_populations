            RowBox[{"(", 
             RowBox[{"1", "-", "h"}], ")"}]}], ")"}]}], "+", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"EulerGamma", "+", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"2", "-", 
               RowBox[{"3", " ", "h"}]}], ")"}], " ", 
             RowBox[{"Log", "[", "h", "]"}]}], "+", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"3", " ", "h"}], "-", "1"}], ")"}], " ", 
             RowBox[{"Log", "[", 
              RowBox[{"1", "-", "h"}], "]"}]}]}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{"h", " ", "s", " ", 
            RowBox[{"(", 
             RowBox[{"1", "-", "h"}], ")"}]}], ")"}]}]}]}], ";", 
       "\[IndentingNewLine]", 
