              RowBox[{"Style", "[", 
               RowBox[{"\"\<,\>\"", ",", "Italic"}], "]"}], ",", 
              RowBox[{
               RowBox[{"SubsuperscriptBox", "[", 
                RowBox[{
                 RowBox[{"Style", "[", 
