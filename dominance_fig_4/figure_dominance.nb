  RowBox[{"Quit", "[", "]"}]}]], "Input",
 CellChangeTimes->{{3.929805465923884*^9, 3.929805467255088*^9}},
 CellLabel->"In[28]:=",ExpressionUUID->"4be81049-e0c1-4be2-b917-0218533648d1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"N1", "=", "1000"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"s0", "=", "0.1"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"h", "=", "0.8"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"x0", "=", 
     RowBox[{"1", "/", 
      RowBox[{"(", 
       RowBox[{"2", " ", "N1"}], ")"}]}]}], ";"}], "\n", 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"si", "[", "t_", "]"}], ":=", "s0"}], ";"}], 
   "\[IndentingNewLine]", "\n", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"taui", "[", "t_", "]"}], ":=", 
     RowBox[{
      RowBox[{"taui", "[", "t", "]"}], "=", 
      RowBox[{"h", "*", 
       RowBox[{"NIntegrate", "[", 
        RowBox[{
         RowBox[{"si", "[", "t1", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"t1", ",", "0", ",", "t"}], "}"}]}], "]"}]}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", "\n", 
   RowBox[{
    RowBox[{"pf1", "=", 
     RowBox[{"2", "/", 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"NIntegrate", "[", 
         RowBox[{
          RowBox[{"Exp", "[", 
           RowBox[{"-", 
            RowBox[{"taui", "[", "t", "]"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", "0", ",", "Infinity"}], "}"}]}], "]"}]}], 
       ")"}]}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"C1", "=", 
     RowBox[{"2", " ", "N1", " ", "pf1"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"B", "[", "Te_", "]"}], ":=", 
     RowBox[{
      RowBox[{"B", "[", "Te", "]"}], "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"2", " ", "N1"}], ")"}], "/", 
       RowBox[{"NIntegrate", "[", 
        RowBox[{
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", "-", "h"}], ")"}], "/", "h"}], " ", 
           RowBox[{"taui", "[", "t", "]"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "0", ",", "Te"}], "}"}]}], "]"}]}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"pdfgenh", "[", "Te_", "]"}], ":=", 
     RowBox[{
      RowBox[{"pdfgenh", "[", "Te", "]"}], "=", 
      RowBox[{
       RowBox[{"h", "/", 
        RowBox[{"(", 
         RowBox[{"1", "-", "h"}], ")"}]}], " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"C1", " ", 
          RowBox[{
           RowBox[{"B", "[", "Te", "]"}], "^", "2"}]}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{"2", " ", "N1"}], ")"}]}], " ", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "-", "h"}], ")"}], "/", "h"}], " ", 
         RowBox[{"taui", "[", "Te", "]"}]}], "]"}], "*", 
       RowBox[{"NIntegrate", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"q", "^", 
           RowBox[{"(", 
            RowBox[{"-", 
             RowBox[{"(", 
              RowBox[{"h", "/", 
               RowBox[{"(", 
                RowBox[{"1", "-", "h"}], ")"}]}], ")"}]}], ")"}]}], " ", 
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", 
             RowBox[{"B", "[", "Te", "]"}]}], " ", "q"}], "]"}], " ", 
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", "C1"}], " ", 
            RowBox[{"q", "^", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", "h"}], "/", 
               RowBox[{"(", 
                RowBox[{"1", "-", "h"}], ")"}]}], ")"}]}]}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"q", ",", "0", ",", "Infinity"}], "}"}], ",", 
         RowBox[{"MaxRecursion", "->", "20"}]}], "]"}]}]}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"a3", "=", 
    RowBox[{"Plot", "[", 
     RowBox[{
      RowBox[{"pdfgenh", "[", "t", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "1", ",", "800"}], "}"}], ",", 
      RowBox[{"PlotRange", "->", "All"}], ",", 
      RowBox[{"PlotPoints", "->", "50"}]}], "]"}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\n", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   
   RowBox[{
    RowBox[{"timePoints", "=", 
     RowBox[{"Range", "[", 
      RowBox[{"1", ",", "800", ",", "1"}], "]"}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"weightValues", "=", 
     RowBox[{"pdfgenh", "/@", "timePoints"}]}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{
    RowBox[{"Datatfix", "=", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"timePoints", ",", "weightValues"}], "}"}], "]"}]}], 
    ";"}]}]}]], "Input",
