Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"xaxis", "=", 
     RowBox[{"Table", "[", 
      RowBox[{"x", ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "0.001", ",", "0.999", ",", "0.001"}], "}"}]}], 
      "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Data", "=", 
     RowBox[{"Transpose", "@", 
      RowBox[{"{", 
       RowBox[{"xaxis", ",", 
        RowBox[{"xaxis", " ", 
         FractionBox["gData", "theta"]}]}], "}"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Data1", "=", 
     RowBox[{"Interpolation", "@", "Data"}]}], ";"}], "\[IndentingNewLine]", 
   "\n", 
