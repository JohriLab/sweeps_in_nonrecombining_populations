       RowBox[{"\"\<x\>\"", ",", "\"\<Average gData\>\""}], "}"}]}], ",", 
     RowBox[{"FrameStyle", "->", 
      RowBox[{"Directive", "[", 
       RowBox[{
        RowBox[{"Thickness", "[", "0.005", "]"}], ",", "Black"}], "]"}]}], 
     ",", " ", 
     RowBox[{"PlotStyle", "\[Rule]", "Red"}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.9321380364959793`*^9, 3.9321380369528437`*^9}, {
  3.932138137637847*^9, 3.932138141916654*^9}},
