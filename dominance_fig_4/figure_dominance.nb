   RowBox[{
    RowBox[{"mu", "=", 
     RowBox[{"10", "^", 
      RowBox[{"-", "7"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"L", "=", "99999"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"theta", "=", 
     RowBox[{"4", " ", "N1", " ", "mu", " ", "L"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"fun01", "=", 
     RowBox[{"Interpolation", "[", "Datah2", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"fun02", "=", 
     RowBox[{"Interpolation", "[", "Datah5", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"fun03", "=", 
     RowBox[{"Interpolation", "[", "Datah8", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"list01", "=", 
     RowBox[{"Table", "[", 
