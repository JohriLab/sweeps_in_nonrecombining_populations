        RowBox[{"g", "[", 
         RowBox[{"1", ",", "t"}], "]"}], "==", "0"}], ",", 
       RowBox[{
        RowBox[{"g", "[", 
         RowBox[{"0", ",", "t"}], "]"}], "==", 
        RowBox[{
         RowBox[{"x1", "[", "t", "]"}], " ", "theta", " ", 
         RowBox[{"(", 
          RowBox[{"1", "-", 
           RowBox[{"Exp", "[", 
            RowBox[{
             RowBox[{"-", "10000000"}], " ", "t"}], "]"}]}], ")"}]}]}], ",", 
       RowBox[{
        RowBox[{"g", "[", 
         RowBox[{"x", ",", "0"}], "]"}], "==", "0"}]}], "}"}], ",", "g", ",", 
     
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "1000"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "1"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gData", "=", 
   RowBox[{"Table", "[", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"G", "[", 
       RowBox[{"x", ",", "tfix"}], "]"}], "/", 
