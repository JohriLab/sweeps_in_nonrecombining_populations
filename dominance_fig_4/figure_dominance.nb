       RowBox[{"{", "\"\<h=0.2\>\"", "}"}]}], ",", 
      RowBox[{"PlotRange", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0.001", ",", "1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"0.01", ",", "1"}], "}"}]}], "}"}]}], ",", " ", 
      RowBox[{"PlotMarkers", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"\"\<\[FilledUpTriangle]\>\"", ",", "12"}], "}"}]}]}], 
     "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Show", " ", "both", " ", "plots"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", "a1sCombined", "]"}]}], "Input",
