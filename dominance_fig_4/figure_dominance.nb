             RowBox[{
              RowBox[{"Style", "[", 
               RowBox[{"\"\<f(\>\"", ",", "Italic"}], "]"}], ",", 
              RowBox[{"Style", "[", 
               RowBox[{"\"\<x\>\"", ",", "Italic"}], "]"}], ",", 
              RowBox[{"Style", "[", 
               RowBox[{"\"\<,\>\"", ",", "Italic"}], "]"}], ",", 
              RowBox[{
               RowBox[{"SubsuperscriptBox", "[", 
                RowBox[{
                 RowBox[{"Style", "[", 
                  RowBox[{"\"\<t\>\"", ",", "Italic"}], "]"}], ",", 
                 RowBox[{"Style", "[", 
                  RowBox[{"\"\<fix\>\"", ",", "Italic"}], "]"}], ",", 
                 "\"\<*\>\""}], "]"}], "//", "DisplayForm"}], ",", 
              RowBox[{"Style", "[", 
               RowBox[{"\"\<) / \>\"", ",", "Italic"}], "]"}], ",", 
              RowBox[{
               RowBox[{"SubscriptBox", "[", 
                RowBox[{
                 RowBox[{"Style", "[", 
                  RowBox[{"\"\<f\>\"", ",", "Italic"}], "]"}], ",", 
                 "\"\<\!\(\*StyleBox[\"neu\",FontSlant->\"Italic\"]\)\>\""}], 
                "]"}], "//", "DisplayForm"}], ",", 
              RowBox[{"Style", "[", 
               RowBox[{"\"\<(x)\>\"", ",", "Italic"}], "]"}]}], "}"}], "]"}], 
           "]"}]}], "}"}]}], ",", 
       RowBox[{"FrameStyle", "->", 
        RowBox[{"Thickness", "[", ".003", "]"}]}], ",", 
       RowBox[{"FrameTicks", "->", "Automatic"}], ",", 
       RowBox[{"LabelStyle", "->", 
