         "\"\<Normalized Sample SFS\>\""}], "}"}]}], ",", 
      RowBox[{"FrameStyle", "->", 
       RowBox[{"Thickness", "[", ".003", "]"}]}], ",", 
      RowBox[{"LabelStyle", "->", 
       RowBox[{"Directive", "[", 
        RowBox[{"Black", ",", "Bold", ",", "Medium"}], "]"}]}], ",", 
      RowBox[{"BaseStyle", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"FontWeight", "->", "\"\<Bold\>\""}], ",", 
         RowBox[{"FontSize", "->", "10"}], ",", 
         RowBox[{"FontFamily", "->", "\"\<Calibri\>\""}]}], "}"}]}], ",", 
      RowBox[{"ChartLegends", "->", 
