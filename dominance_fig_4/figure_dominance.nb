  RowBox[{
   RowBox[{
    RowBox[{"xaxis", "=", 
     RowBox[{"Table", "[", 
      RowBox[{"x", ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "0.001", ",", "0.999", ",", "0.001"}], "}"}]}], 
      "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Data", "=", 
     RowBox[{"Transpose", "@", 
      RowBox[{"{", 
       RowBox[{"xaxis", ",", " ", "gData"}], "}"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Data1", "=", 
     RowBox[{"Interpolation", "@", "Data"}]}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{"a4", "=", 
    RowBox[{"ListLogLogPlot", "[", 
     RowBox[{"Data", ",", 
      RowBox[{"PlotStyle", "->", "Red"}]}], "]"}]}]}]}]], "Input",
