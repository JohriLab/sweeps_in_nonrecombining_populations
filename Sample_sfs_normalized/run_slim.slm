#!/bin/bash

#SBATCH --mail-user=sackau@unc.edu
#SBATCH --mail-type=ALL
#SBATCH -p general
#SBATCH -N 1
#SBATCH -t 00-24:00:00
#SBATCH --mem=2g
#SBATCH -a 1-1000
#SBATCH -n 1
#SBATCH -o /nas/longleaf/home/sackau/LOGFILES/test_%A_%a.o
#SBATCH -e /nas/longleaf/home/sackau/LOGFILES/test_%A_%a.e

if [[ -z "$SLURM_ARRAY_TASK_ID" ]]; then
   echo "SLURM_ARRAY_TASK_ID is not set!"
   exit 1
fi

# Calculate start and end for the loop based on SLURM_ARRAY_TASK_ID

CHUNK_SIZE=1000
echo "SLURM_ARRAY_TASK_ID: $SLURM_ARRAY_TASK_ID"
echo "CHUNK_SIZE: $CHUNK_SIZE"
START=$(( ($SLURM_ARRAY_TASK_ID - 1) * $CHUNK_SIZE + 1))
 END=$(($SLURM_ARRAY_TASK_ID * $CHUNK_SIZE))

 echo "Start: $START"
 echo "End: $END"
# Adjust END for the last chunk
if [ "$SLURM_ARRAY_TASK_ID" -eq 1000 ]; then
    END=1000000
fi
cd /work/users/s/a/sackau/UNC_work/Corresponding_SFS_sample

module load slim
output_dir="/work/users/s/a/sackau/UNC_work/Corresponding_SFS_sample/Sample_txt_files_1000_20/$SLURM_ARRAY_TASK_ID"
mkdir -p "$output_dir"
for ((i = $START; i <= $END; i++)); do

# Reset SECONDS to start counting from 0
SECONDS=0

    # Record start time for this iteration
    iteration_start_time=$SECONDS
    
    # Create a unique output file name
    output_file="$output_dir/output_${i}.txt"
    
    # If i=1, save the full output as well
    if [ "$SLURM_ARRAY_TASK_ID" -eq 1 ] && [ "$i" -eq 1 ]; then
        slim sample_SS_N_1k_s_0.1_h_0.5.slim | tee "/work/users/s/a/sackau/UNC_work/Corresponding_SFS_sample/Sample_txt_files/full_output_1.txt" | awk '/Mutations:/, /Genomes/ { if (/Mutations:/) flag=1; else if (/Genomes/) flag=0; if (flag && NF) print $NF }' | sed '1d;$d' > "$output_file"
    else
        # For other iterations, process as before
        slim sample_SS_N_1k_s_0.1_h_0.5.slim | awk '/Mutations:/, /Genomes/ { if (/Mutations:/) flag=1; else if (/Genomes/) flag=0; if (flag && NF) print $NF }' | sed '1d;$d' > "$output_file"
    fi
    
    # Calculate iteration elapsed time
    iteration_elapsed_time=$(( SECONDS - iteration_start_time ))
    
    echo "Iteration $i completed in $iteration_elapsed_time seconds. Total elapsed: $SECONDS seconds."

done
echo "All iterations completed."
