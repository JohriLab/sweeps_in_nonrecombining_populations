Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"N1", "=", "1000"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"mu", "=", 
     RowBox[{"10", "^", 
      RowBox[{"-", "7"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"L", "=", "10000"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"theta", "=", 
     RowBox[{"4", " ", "N1", " ", "mu", " ", "L"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"s1s", "=", 
     RowBox[{
     "OpenRead", "[", 
      "\"\</Users/user/Desktop/Slim_programs/Sel_sfs_independent/Sweeps_\
project/hard_sweep/average_data_high_CI_paper_s_0.1.txt\>\"", "]"}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"datas1s", "=", 
     RowBox[{"ReadList", "[", 
      RowBox[{"s1s", ",", 
       RowBox[{"{", 
        RowBox[{"Number", ",", "Number"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Close", "[", "s1s", "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"x11s", "=", 
     RowBox[{"datas1s", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"x21s", "=", 
     RowBox[{"datas1s", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Data1s", "=", 
     RowBox[{"Transpose", "@", 
      RowBox[{"{", 
       RowBox[{"x11s", ",", 
        RowBox[{"x11s", " ", 
         FractionBox["x21s", "theta"]}]}], "}"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Define", " ", "logarithmic", " ", "binning", " ", "and", " ", 
     "smoothing", " ", "function"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"smoothDataLog", "[", 
      RowBox[{"data_", ",", "numBins_", ",", "xThreshold_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "filteredData", ",", "bins", ",", "binnedData", ",", "binEdges", ",", 
         "binnedX", ",", "binnedY", ",", "counts", ",", "logMin", ",", 
         "logMax", ",", "logBinEdges"}], "}"}], ",", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
         "Filter", " ", "data", " ", "to", " ", "include", " ", "only", " ", 
          "points", " ", "where", " ", "x"}], ">", "xThreshold"}], "*)"}], 
       RowBox[{
        RowBox[{"filteredData", "=", 
         RowBox[{"Select", "[", 
          RowBox[{"data", ",", 
           RowBox[{
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ">", "xThreshold"}], "&"}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "Determine", " ", "the", " ", "range", " ", "and", " ", "width", " ",
           "of", " ", "bins", " ", "for", " ", "filtered", " ", "data"}], 
         "*)"}], 
        RowBox[{"logMin", "=", 
         RowBox[{"Log10", "[", 
          RowBox[{"Min", "[", 
           RowBox[{"filteredData", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"logMax", "=", 
         RowBox[{"Log10", "[", 
          RowBox[{"Max", "[", 
           RowBox[{"filteredData", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"logBinEdges", "=", 
         RowBox[{"Range", "[", 
          RowBox[{"logMin", ",", "logMax", ",", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"logMax", "-", "logMin"}], ")"}], "/", "numBins"}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"bins", "=", 
         RowBox[{"10", "^", "logBinEdges"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Initialize", " ", "bins"}], "*)"}], 
        RowBox[{"binnedX", "=", 
         RowBox[{"Table", "[", 
          RowBox[{"0", ",", 
           RowBox[{"{", "numBins", "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"binnedY", "=", 
         RowBox[{"Table", "[", 
          RowBox[{"0", ",", 
           RowBox[{"{", "numBins", "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"counts", "=", 
         RowBox[{"Table", "[", 
          RowBox[{"0", ",", 
           RowBox[{"{", "numBins", "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Bin", " ", "the", " ", "data"}], "*)"}], 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{"Module", "[", 
           RowBox[{
            RowBox[{"{", "binIndex", "}"}], ",", 
            RowBox[{
             RowBox[{"binIndex", "=", 
              RowBox[{
               RowBox[{"Floor", "[", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"Log10", "[", 
                    RowBox[{"filteredData", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "1"}], "]"}], "]"}], "]"}], "-", 
                   "logMin"}], ")"}], "/", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"logMax", "-", "logMin"}], ")"}], "/", 
                   "numBins"}], ")"}]}], "]"}], "+", "1"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"binIndex", ">", "0"}], "&&", 
                RowBox[{"binIndex", "<=", "numBins"}]}], ",", 
               RowBox[{
                RowBox[{
                 RowBox[{"binnedX", "[", 
                  RowBox[{"[", "binIndex", "]"}], "]"}], "+=", 
                 RowBox[{"filteredData", "[", 
                  RowBox[{"[", 
                   RowBox[{"i", ",", "1"}], "]"}], "]"}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"binnedY", "[", 
                  RowBox[{"[", "binIndex", "]"}], "]"}], "+=", 
                 RowBox[{"filteredData", "[", 
                  RowBox[{"[", 
                   RowBox[{"i", ",", "2"}], "]"}], "]"}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"counts", "[", 
                  RowBox[{"[", "binIndex", "]"}], "]"}], "+=", "1"}], ";"}]}],
               "]"}]}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"Length", "[", "filteredData", "]"}]}], "}"}]}], "]"}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "Calculate", " ", "mean", " ", "values", " ", "for", " ", "each", 
          " ", "bin"}], "*)"}], 
        RowBox[{"binnedData", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"counts", "[", 
               RowBox[{"[", "i", "]"}], "]"}], ">", "0"}], ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{
                RowBox[{"binnedX", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "/", 
                RowBox[{"counts", "[", 
                 RowBox[{"[", "i", "]"}], "]"}]}], ",", 
               RowBox[{
                RowBox[{"binnedY", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "/", 
                RowBox[{"counts", "[", 
                 RowBox[{"[", "i", "]"}], "]"}]}]}], "}"}], ",", "Nothing"}], 
            "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "numBins"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Return", " ", "the", " ", "smoothed", " ", "data"}], "*)"}],
         "binnedData"}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Apply", " ", "the", " ", "smoothing", " ", "function", " ", "to", " ", 
     "your", " ", "data"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"numBins", "=", "100"}], ";", 
    RowBox[{"(*", 
     RowBox[{
     "Adjust", " ", "the", " ", "number", " ", "of", " ", "bins", " ", "as", 
      " ", "needed"}], "*)"}], 
    RowBox[{"xThreshold", "=", "0.005"}], ";", 
    RowBox[{"(*", 
     RowBox[{"Threshold", " ", "for", " ", "binning"}], "*)"}], 
    RowBox[{"smoothedData", "=", 
     RowBox[{"smoothDataLog", "[", 
      RowBox[{"Data1s", ",", "numBins", ",", "xThreshold"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Separate", " ", "data", " ", "into", " ", "two", " ", 
     RowBox[{"parts", ":", 
      RowBox[{"original", " ", "part", " ", 
       RowBox[{"(", 
        RowBox[{"x", "<=", "0.5"}], ")"}], " ", "and", " ", "smoothed", " ", 
       "part", " ", 
       RowBox[{"(", 
        RowBox[{"x", ">", "0.5"}], ")"}]}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"originalPart", "=", 
     RowBox[{"Select", "[", 
      RowBox[{"Data1s", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "<=", "xThreshold"}], "&"}]}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"smoothedPart", "=", 
     RowBox[{"Select", "[", 
      RowBox[{"smoothedData", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ">", "xThreshold"}], "&"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
