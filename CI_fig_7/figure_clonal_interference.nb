 RowBox[{"\[IndentingNewLine]", 
  RowBox[{"Quit", "[", "]"}]}]], "Input",
 CellChangeTimes->{{3.93274759572987*^9, 3.932747597071262*^9}},
 CellLabel->"In[9]:=",ExpressionUUID->"c9097545-d55b-42ec-970c-03b920a8f18b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"N1", "=", "1000"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"mu", "=", 
   RowBox[{"10", "^", 
    RowBox[{"-", "7"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"L", "=", "10000"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"theta", "=", 
   RowBox[{"4", " ", "N1", " ", "mu", " ", "L"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"N1", "=", "1000"}], ";", 
  RowBox[{"s", "=", "0.05"}], ";", 
  RowBox[{"h", "=", "0.5"}], ";", 
  RowBox[{"x0", "=", 
   RowBox[{"1", "/", 
    RowBox[{"(", 
     RowBox[{"2", " ", "2", " ", "s", " ", "h", " ", "N1"}], ")"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"x1", "=", 
    RowBox[{"NDSolveValue", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"x2a", "[", "t", "]"}], ",", "t"}], "]"}], "==", 
         RowBox[{"h", " ", "s", "*", 
          RowBox[{"x2a", "[", "t", "]"}], "*", 
          RowBox[{"(", 
           RowBox[{"1", "-", 
            RowBox[{"x2a", "[", "t", "]"}]}], ")"}]}]}], ",", 
        RowBox[{
         RowBox[{"x2a", "[", "0", "]"}], "==", "x0"}]}], "}"}], ",", "x2a", 
      ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "0", ",", "4000"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Tfix", "=", 
   RowBox[{
    FractionBox[
     RowBox[{"Log", "[", 
      RowBox[{"2", " ", "2", " ", "N1", " ", "s"}], "  ", "]"}], 
     RowBox[{"h", "  ", "s", " ", 
      RowBox[{"(", 
       RowBox[{"1", "-", "h"}], ")"}]}]], "+", " ", 
    FractionBox[
     RowBox[{"EulerGamma", "+", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"2", "-", " ", 
         RowBox[{"3", " ", "h"}]}], ")"}], 
       RowBox[{"Log", "[", "h", "]"}]}], " ", "+", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"3", " ", "h"}], "-", "1"}], ")"}], " ", 
       RowBox[{"Log", "[", 
        RowBox[{"1", "-", "h"}], "]"}]}]}], 
     RowBox[{"h", "  ", "s", " ", 
      RowBox[{"(", 
       RowBox[{"1", "-", "h"}], ")"}]}]]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"averageGData", "=", 
    RowBox[{"{", "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"G", "=", 
   RowBox[{"NDSolveValue", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"g", "[", 
           RowBox[{"x", ",", "t"}], "]"}], ",", "t"}], "]"}], "==", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"x", " ", 
            RowBox[{"(", 
             RowBox[{"1", "-", "x"}], ")"}]}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{"4", " ", "N1", "*", 
            RowBox[{"x1", "[", "t", "]"}]}], ")"}]}], " ", 
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"g", "[", 
            RowBox[{"x", ",", "t"}], "]"}], ",", "x", ",", "x"}], "]"}]}]}], 
       ",", 
       RowBox[{
        RowBox[{"g", "[", 
         RowBox[{"1", ",", "t"}], "]"}], "==", "0"}], ",", 
       RowBox[{
        RowBox[{"g", "[", 
         RowBox[{"0", ",", "t"}], "]"}], "==", 
        RowBox[{
         RowBox[{"x1", "[", "t", "]"}], " ", "theta", " ", 
         RowBox[{"(", 
          RowBox[{"1", "-", 
           RowBox[{"Exp", "[", 
            RowBox[{
             RowBox[{"-", "10000000"}], " ", "t"}], "]"}]}], ")"}]}]}], ",", 
       RowBox[{
        RowBox[{"g", "[", 
         RowBox[{"x", ",", "0"}], "]"}], "==", "0"}]}], "}"}], ",", "g", ",", 
     
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "1000"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "1"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gData", "=", 
   RowBox[{"Table", "[", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"G", "[", 
       RowBox[{"x", ",", "Tfix"}], "]"}], "/", 
      RowBox[{"(", 
       RowBox[{"x", "*", 
        RowBox[{"(", 
         RowBox[{"1", "-", "x"}], ")"}]}], ")"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0.001", ",", "0.999", ",", "0.001"}], "}"}]}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"AppendTo", "[", 
   RowBox[{"averageGData", ",", "gData"}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"averageGData1", "=", 
    RowBox[{"Mean", "[", "averageGData", "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"xaxis", "=", 
    RowBox[{"Table", "[", 
     RowBox[{"x", ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "0.001", ",", ".999", ",", "0.001"}], "}"}]}], 
     "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"ListLogLogPlot", "[", 
  RowBox[{
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{"xaxis", ",", "averageGData1"}], "}"}], "]"}], ",", 
   RowBox[{"Frame", "->", "True"}], ",", 
   RowBox[{"FrameLabel", "->", 
