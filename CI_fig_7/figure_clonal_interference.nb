Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"N1", "=", "1000"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"mu", "=", 
     RowBox[{"10", "^", 
      RowBox[{"-", "7"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"L", "=", "10000"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"theta", "=", 
     RowBox[{"4", " ", "N1", " ", "mu", " ", "L"}]}], ";"}], "\n", "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"alpha", "=", "10"}], ";", " ", 
    RowBox[{"(*", " ", 
     RowBox[{"s", " ", "mean"}], "*)"}], "\n", 
    RowBox[{"ratio", "=", "0.005"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"mu1", "=", 
     RowBox[{"0.005", " ", 
      RowBox[{"10", "^", 
       RowBox[{"-", "7"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"s", "=", "0.05"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"h", "=", "0.5"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"l1", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"mu1", " ", "1000"}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"s", " ", "h"}], ")"}]}], " ", "N1", " ", 
      RowBox[{"Log", "[", "N1", "]"}], " ", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", "alpha"}], " ", "s"}], "]"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", " ", "h", " ", "s"}], "+", 
        RowBox[{"1", "/", "alpha"}]}], ")"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"N1", "=", "1000"}], ";", 
    RowBox[{"s", "=", "0.05"}], ";", 
    RowBox[{"h", "=", "0.5"}], ";", 
    RowBox[{"x0", "=", 
     RowBox[{"1", "/", 
      RowBox[{"(", 
       RowBox[{"2", " ", "2", " ", "h", " ", "s", " ", 
        RowBox[{"Exp", "[", 
         RowBox[{"-", "l1"}], "]"}], "  ", "N1"}], ")"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"N1", "=", "1000"}], ";", 
     RowBox[{"s", "=", "0.05"}], ";", 
     RowBox[{"h", "=", "0.5"}], ";", 
     RowBox[{"x0", "=", 
      RowBox[{"1", "/", 
       RowBox[{"(", 
        RowBox[{"2", " ", "2", " ", "h", " ", "s", " ", "N1"}], ")"}]}]}], 
     ";"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"x1", "=", 
     RowBox[{"NDSolveValue", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"x2a", "[", "t", "]"}], ",", "t"}], "]"}], "==", 
          RowBox[{"h", " ", "s", "*", 
           RowBox[{"x2a", "[", "t", "]"}], "*", 
           RowBox[{"(", 
            RowBox[{"1", "-", 
             RowBox[{"x2a", "[", "t", "]"}]}], ")"}]}]}], ",", 
         RowBox[{
          RowBox[{"x2a", "[", "0", "]"}], "==", "x0"}]}], "}"}], ",", "x2a", 
       ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", "1000"}], "}"}]}], "]"}]}], ";"}], " ", 
   "\[IndentingNewLine]", "\n", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   
   RowBox[{
    RowBox[{"averageGData", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"G", "=", 
     RowBox[{"NDSolveValue", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"g", "[", 
             RowBox[{"x", ",", "t"}], "]"}], ",", "t"}], "]"}], "==", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"x", " ", 
              RowBox[{"(", 
               RowBox[{"1", "-", "x"}], ")"}]}], ")"}], "/", 
            RowBox[{"(", 
             RowBox[{"4", " ", "N1", "*", 
              RowBox[{"x1", "[", "t", "]"}]}], ")"}]}], " ", 
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"g", "[", 
              RowBox[{"x", ",", "t"}], "]"}], ",", "x", ",", "x"}], "]"}]}]}],
          ",", 
         RowBox[{
          RowBox[{"g", "[", 
           RowBox[{"1", ",", "t"}], "]"}], "==", "0"}], ",", 
         RowBox[{
          RowBox[{"g", "[", 
           RowBox[{"0", ",", "t"}], "]"}], "==", 
          RowBox[{
           RowBox[{"x1", "[", "t", "]"}], " ", "theta", " ", 
           RowBox[{"(", 
            RowBox[{"1", "-", 
             RowBox[{"Exp", "[", 
              RowBox[{
               RowBox[{"-", "10000000"}], " ", "t"}], "]"}]}], ")"}]}]}], ",", 
         RowBox[{
          RowBox[{"g", "[", 
           RowBox[{"x", ",", "0"}], "]"}], "==", "0"}]}], "}"}], ",", "g", 
