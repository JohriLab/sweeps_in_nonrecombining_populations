         RowBox[{"\"\<Simulations\>\"", ",", "\"\<Diffusion\>\""}], "}"}]}]}],
       "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"a2s", "=", 
     RowBox[{"LogLogPlot", "[", 
      RowBox[{
       RowBox[{"theta", "/", "x"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "0", ",", "1"}], "}"}], ",", 
