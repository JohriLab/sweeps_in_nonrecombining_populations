 RowBox[{
  RowBox[{"N1", " ", "=", " ", "1000"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"mu", " ", "=", " ", 
   RowBox[{"10", "^", 
    RowBox[{"-", "7"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"L", " ", "=", " ", 
   RowBox[{
    FractionBox["10", "100"], " ", "1000"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"theta", " ", "=", " ", 
    RowBox[{"4", " ", "N1", " ", "mu", " ", "L"}]}], ";"}], " "}], "\n", 
 RowBox[{
  RowBox[{
