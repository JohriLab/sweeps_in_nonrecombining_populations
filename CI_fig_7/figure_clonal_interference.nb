     RowBox[{"\"\<x\>\"", ",", "\"\<Average gData\>\""}], "}"}]}], ",", 
   RowBox[{"FrameStyle", "->", 
    RowBox[{"Directive", "[", 
     RowBox[{
      RowBox[{"Thickness", "[", "0.005", "]"}], ",", "Black"}], "]"}]}], ",", 
   " ", 
   RowBox[{"PlotStyle", "\[Rule]", "Red"}]}], 
  "]"}], "\[IndentingNewLine]"}], "Input",
