          RowBox[{"{", 
           RowBox[{"0.001", ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0.015", ",", "1.2"}], "}"}]}], "}"}]}], ",", " ", 
       RowBox[{"PlotMarkers", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"\"\<\[SixPointedStar]\>\"", ",", "12"}], "}"}]}]}], "]"}]}],
     ";"}], "\[IndentingNewLine]", "\n", 
