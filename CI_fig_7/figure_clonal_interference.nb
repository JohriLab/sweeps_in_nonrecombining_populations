       RowBox[{"PlotLegends", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<Simulations\>\"", ",", "\"\<Diffusion\>\""}], "}"}]}]}],
       "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"a2s", "=", 
     RowBox[{"LogLogPlot", "[", 
      RowBox[{
       RowBox[{"theta", "/", "x"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "0", ",", "1"}], "}"}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Lighter", "[", 
           RowBox[{"Blue", ",", "0.3"}], "]"}], ",", 
          RowBox[{"Thickness", "[", "0.005", "]"}]}], "}"}]}], ",", 
       RowBox[{"PlotLegends", "->", 
        RowBox[{"{", 
         RowBox[{
         "\"\<\\!\\(\\*FractionBox[\\(\[Theta]\\), \\(x\\)]\\)\>\"", ",", 
          "\"\<Diffusion\>\""}], "}"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"a3s", "=", 
     RowBox[{"LogLogPlot", "[", 
      RowBox[{
       RowBox[{"theta", "/", 
        RowBox[{"(", 
         RowBox[{"50", " ", 
          RowBox[{"x", "^", "2"}]}], ")"}]}], ",", 
       RowBox[{"{", 
