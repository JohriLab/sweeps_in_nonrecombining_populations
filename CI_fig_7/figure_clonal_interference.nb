        RowBox[{"Directive", "[", 
         RowBox[{"Black", ",", "Bold", ",", "Medium"}], "]"}]}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", "Black", "}"}]}], ",", 
       RowBox[{"PlotLegends", "->", 
        RowBox[{"{", "\"\<h=0.2\>\"", "}"}]}], ",", 
       RowBox[{"PlotRange", "->", 
        RowBox[{"{", 
