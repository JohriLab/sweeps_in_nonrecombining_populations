    RowBox[{"s", "=", "0.05"}], ";", 
    RowBox[{"h", "=", "0.5"}], ";", 
    RowBox[{"x0", "=", 
     RowBox[{"1", "/", 
      RowBox[{"(", 
       RowBox[{"2", " ", "2", " ", "s", " ", "h", " ", "N1"}], ")"}]}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    FractionBox[
     RowBox[{"Log", "[", 
      RowBox[{"2", " ", "2", " ", "N1", " ", "s"}], "  ", "]"}], 
     RowBox[{"h", "  ", "s", " ", 
      RowBox[{"(", 
       RowBox[{"1", "-", "h"}], ")"}]}]], "+", " ", 
    FractionBox[
     RowBox[{"EulerGamma", "+", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"2", "-", " ", 
         RowBox[{"3", " ", "h"}]}], ")"}], 
       RowBox[{"Log", "[", "h", "]"}]}], " ", "+", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"3", " ", "h"}], "-", "1"}], ")"}], " ", 
       RowBox[{"Log", "[", 
        RowBox[{"1", "-", "h"}], "]"}]}]}], 
     RowBox[{"h", "  ", "s", " ", 
      RowBox[{"(", 
       RowBox[{"1", "-", "h"}], ")"}]}]]}]}]}]], "Input",
 CellChangeTimes->{{3.9327475319575663`*^9, 3.932747540920282*^9}},
 CellLabel->"In[3]:=",ExpressionUUID->"e6de0102-a168-47b8-ae04-f513dae4fef4"],

