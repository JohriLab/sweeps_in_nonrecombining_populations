Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"N1", "=", "1000"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"mu", "=", 
     RowBox[{"10", "^", 
      RowBox[{"-", "7"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"L", "=", "10000"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"theta", "=", 
     RowBox[{"4", " ", "N1", " ", "mu", " ", "L"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"s1s", "=", 
     RowBox[{
     "OpenRead", "[", 
      "\"\</Users/user/Desktop/Slim_programs/Sel_sfs_independent/Sweeps_\
project/hard_sweep/average_data_No_CI_paper.txt\>\"", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"datas1s", "=", 
     RowBox[{"ReadList", "[", 
      RowBox[{"s1s", ",", 
       RowBox[{"{", 
        RowBox[{"Number", ",", "Number"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Close", "[", "s1s", "]"}], ";"}], "\n", "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"x11s", "=", 
     RowBox[{"datas1s", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"x21s", "=", 
     RowBox[{"datas1s", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Data1s", "=", 
     RowBox[{"Transpose", "@", 
      RowBox[{"{", 
       RowBox[{"x11s", ",", "x21s"}], "}"}]}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"a1s", "=", 
     RowBox[{"ListLogLogPlot", "[", 
      RowBox[{
       RowBox[{"{", "Data1s", "}"}], ",", 
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<x\>\"", ",", 
          RowBox[{"Style", "[", 
           RowBox[{"\"\<f(x, t_{fix})\>\"", ",", "Italic", ",", "Medium"}], 
           "]"}]}], "}"}]}], ",", 
       RowBox[{"FrameStyle", "->", 
        RowBox[{"Thickness", "[", ".003", "]"}]}], ",", 
       RowBox[{"FrameTicks", "->", "Automatic"}], ",", 
       RowBox[{"LabelStyle", "->", 
        RowBox[{"Directive", "[", 
         RowBox[{"Black", ",", "Bold", ",", "Medium"}], "]"}]}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", "Gray", "}"}]}], ",", 
       RowBox[{"PlotLegends", "->", 
        RowBox[{"Placed", "[", 
         RowBox[{
          RowBox[{"{", "\"\<Simulations\>\"", "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0.2", ",", "0.4"}], "}"}]}], "]"}]}]}], "]"}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"a2s", "=", 
     RowBox[{"LogLogPlot", "[", 
      RowBox[{
       RowBox[{"theta", "/", "x"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "0", ",", "1"}], "}"}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Lighter", "[", 
           RowBox[{"Blue", ",", "0.3"}], "]"}], ",", 
          RowBox[{"Thickness", "[", "0.005", "]"}]}], "}"}]}], ",", 
       RowBox[{"PlotLegends", "->", 
        RowBox[{"Placed", "[", 
         RowBox[{
          RowBox[{
          "{", "\"\<\\!\\(\\*FractionBox[\\(\[Theta]\\), \\(x\\)]\\)\>\"", 
           "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0.2", ",", "0.3"}], "}"}]}], "]"}]}]}], "]"}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"a3s", "=", 
     RowBox[{"LogLogPlot", "[", 
      RowBox[{
       RowBox[{"theta", "/", 
        RowBox[{"(", 
         RowBox[{"100", " ", 
          RowBox[{"x", "^", "2"}]}], ")"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "0.1", ",", "1"}], "}"}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", 
         RowBox[{"Black", ",", 
          RowBox[{"Thickness", "[", "0.005", "]"}]}], "}"}]}], ",", 
       RowBox[{"PlotLegends", "->", 
        RowBox[{"Placed", "[", 
         RowBox[{
          RowBox[{
          "{", 
           "\"\<\\!\\(\\*FractionBox[\\(\[Theta]\\ \\*SubscriptBox[\\(p\\), \
\\(0\\)]\\), SuperscriptBox[\\(x\\), \\(2\\)]]\\)\>\"", "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0.2", ",", "0.2"}], "}"}]}], "]"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"Show", "[", 
    RowBox[{"a1s", ",", "a2s", ",", "a3s", ",", 
     RowBox[{"PlotRange", "->", "All"}]}], "]"}], " "}]}]], "Input",
