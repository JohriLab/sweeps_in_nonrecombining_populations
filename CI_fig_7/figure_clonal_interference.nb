          RowBox[{"Thickness", "[", "0.005", "]"}]}], "}"}]}], ",", 
       RowBox[{"PlotLegends", "->", 
        RowBox[{"{", 
         RowBox[{
         "\"\<\\!\\(\\*FractionBox[\\(\[Theta]\\\\\\  \
\\*SubscriptBox[\\(p\\), \\(0\\)]\\), SuperscriptBox[\\(x\\), \
\\(2\\)]]\\)\>\"", ",", "\"\<Diffusion\>\""}], "}"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"Show", "[", 
    RowBox[{"a1s", ",", "a2s", ",", "a3s", ",", 
     RowBox[{"PlotRange", "->", "All"}]}], "]"}]}]}]], "Input",
