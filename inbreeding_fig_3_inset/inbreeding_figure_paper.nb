           RowBox[{"Length", "[", "filteredData", "]"}]}], "}"}]}], "]"}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "Calculate", " ", "mean", " ", "values", " ", "for", " ", "each", " ",
          "bin"}], "*)"}], 
       RowBox[{"binnedData", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"counts", "[", 
              RowBox[{"[", "i", "]"}], "]"}], ">", "0"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"binnedX", "[", 
