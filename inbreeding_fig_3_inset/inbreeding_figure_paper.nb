     RowBox[{"1", "/", 
      RowBox[{"(", 
       RowBox[{"2", " ", "2", " ", "sa", " ", "N1"}], ")"}]}]}], ";"}], "\n", 
   
   RowBox[{
    RowBox[{"x1", "=", 
     RowBox[{"NDSolveValue", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"x2a", "[", "t", "]"}], ",", "t"}], "]"}], "==", 
          RowBox[{
           RowBox[{"x2a", "[", "t", "]"}], "*", 
           RowBox[{"(", 
            RowBox[{"1", "-", 
             RowBox[{"x2a", "[", "t", "]"}]}], ")"}], " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"sa", " ", 
              RowBox[{"(", 
               RowBox[{"1", "-", 
                RowBox[{"x2a", "[", "t", "]"}]}], ")"}]}], " ", "+", " ", 
             RowBox[{"sb", " ", 
              RowBox[{"x2a", "[", "t", "]"}]}]}], ")"}]}]}], ",", 
         RowBox[{
          RowBox[{"x2a", "[", "0", "]"}], "==", "x0"}]}], "}"}], ",", "x2a", 
       ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", "1000"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"G", "=", 
     RowBox[{"NDSolveValue", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"g", "[", 
             RowBox[{"x", ",", "t"}], "]"}], ",", "t"}], "]"}], "==", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"x", " ", 
              RowBox[{"(", 
               RowBox[{"1", "-", "x"}], ")"}]}], ")"}], "/", 
            RowBox[{"(", 
             RowBox[{"4", " ", "N1", "*", 
              RowBox[{"x1", "[", "t", "]"}]}], ")"}]}], " ", 
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"g", "[", 
              RowBox[{"x", ",", "t"}], "]"}], ",", "x", ",", "x"}], "]"}]}]}],
          ",", 
         RowBox[{
          RowBox[{"g", "[", 
           RowBox[{"1", ",", "t"}], "]"}], "==", "0"}], ",", 
         RowBox[{
          RowBox[{"g", "[", 
           RowBox[{"0", ",", "t"}], "]"}], "==", 
          RowBox[{
           RowBox[{"x1", "[", "t", "]"}], " ", "theta", " ", 
           RowBox[{"(", 
            RowBox[{"1", "-", 
             RowBox[{"Exp", "[", 
              RowBox[{
               RowBox[{"-", "10000000"}], " ", "t"}], "]"}]}], ")"}]}]}], ",", 
         RowBox[{
          RowBox[{"g", "[", 
           RowBox[{"x", ",", "0"}], "]"}], "==", "0"}]}], "}"}], ",", "g", 
       ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", "1000"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "0", ",", "1"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"gData", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Datatfix", "[", 
           RowBox[{"[", 
            RowBox[{"k", ",", "2"}], "]"}], "]"}], " ", 
          RowBox[{
           RowBox[{"G", "[", 
            RowBox[{"x", ",", 
             RowBox[{"Datatfix", "[", 
              RowBox[{"[", 
               RowBox[{"k", ",", "1"}], "]"}], "]"}]}], "]"}], "/", 
           RowBox[{"(", 
            RowBox[{"x", "*", 
             RowBox[{"(", 
              RowBox[{"1", "-", "x"}], ")"}]}], ")"}]}]}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "1", ",", 
           RowBox[{"Length", "[", "Datatfix", "]"}]}], "}"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "0.001", ",", "0.999", ",", "0.001"}], "}"}]}], 
      "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"averageGData", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"AppendTo", "[", 
     RowBox[{"averageGData", ",", "gData"}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   "\[IndentingNewLine]"}]}]], "Input",
