  RowBox[{"(*", " ", 
   RowBox[{"theta", "=", " ", 
    RowBox[{"2", " ", "N", " ", "mu"}]}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"s1s", "=", 
