 RowBox[{
  RowBox[{"L", "=", "10000"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "=", "0.8181818181818181`"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sa", "=", 
   RowBox[{"(", 
