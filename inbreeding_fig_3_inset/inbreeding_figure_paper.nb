                RowBox[{"[", "i", "]"}], "]"}], "/", 
               RowBox[{"counts", "[", 
                RowBox[{"[", "i", "]"}], "]"}]}]}], "}"}], ",", "Nothing"}], 
           "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "numBins"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Return", " ", "the", " ", "smoothed", " ", "data"}], "*)"}], 
       "binnedData"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
   "Apply", " ", "the", " ", "smoothing", " ", "function", " ", "to", " ", 
