Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"timePoints", "=", 
     RowBox[{"Range", "[", 
      RowBox[{"1", ",", "1000", ",", "1"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"weightValues", "=", 
     RowBox[{"Pnew", "/@", "timePoints"}]}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Combine", " ", "time", " ", "points", " ", "and", " ", "their", " ", 
     "corresponding", " ", "weights", " ", "into", " ", "a", " ", "single", 
     " ", "list"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Datatfix", "=", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"timePoints", ",", "weightValues"}], "}"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"f", "=", 
     FractionBox["sig", 
      RowBox[{"2", "-", "sig"}]]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"N1", "=", " ", 
     FractionBox["1000", 
      RowBox[{"1", "+", "f"}]]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"mu", "=", 
     SuperscriptBox["10", 
      RowBox[{"-", "6"}]]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"L", "=", "10000"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"theta", "=", 
     RowBox[{"4", " ", "N1", " ", "mu", " ", "L"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"F", "=", 
     FractionBox["sig", 
      RowBox[{"2", "-", "sig"}]]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"s", "=", "0.1"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"h", "=", "0.5"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sa", "=", 
     RowBox[{"s", " ", 
      RowBox[{"(", 
       RowBox[{"h", "+", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "-", "h"}], ")"}], " ", "F"}]}], ")"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sb", "=", " ", 
     RowBox[{"s", " ", 
      RowBox[{"(", 
       RowBox[{"1", "-", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "-", "F"}], ")"}], " ", "h"}]}], ")"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"x0", "=", 
     RowBox[{"1", "/", 
      RowBox[{"(", 
       RowBox[{"2", " ", "2", " ", "sa", " ", "N1"}], ")"}]}]}], ";"}], "\n", 
   
   RowBox[{
    RowBox[{"x1", "=", 
     RowBox[{"NDSolveValue", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"x2a", "[", "t", "]"}], ",", "t"}], "]"}], "==", 
          RowBox[{
           RowBox[{"x2a", "[", "t", "]"}], "*", 
           RowBox[{"(", 
            RowBox[{"1", "-", 
             RowBox[{"x2a", "[", "t", "]"}]}], ")"}], " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"sa", " ", 
              RowBox[{"(", 
               RowBox[{"1", "-", 
                RowBox[{"x2a", "[", "t", "]"}]}], ")"}]}], " ", "+", " ", 
             RowBox[{"sb", " ", 
              RowBox[{"x2a", "[", "t", "]"}]}]}], ")"}]}]}], ",", 
         RowBox[{
          RowBox[{"x2a", "[", "0", "]"}], "==", "x0"}]}], "}"}], ",", "x2a", 
       ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", "1000"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"G", "=", 
     RowBox[{"NDSolveValue", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"g", "[", 
             RowBox[{"x", ",", "t"}], "]"}], ",", "t"}], "]"}], "==", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"x", " ", 
              RowBox[{"(", 
               RowBox[{"1", "-", "x"}], ")"}]}], ")"}], "/", 
            RowBox[{"(", 
             RowBox[{"4", " ", "N1", "*", 
              RowBox[{"x1", "[", "t", "]"}]}], ")"}]}], " ", 
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"g", "[", 
              RowBox[{"x", ",", "t"}], "]"}], ",", "x", ",", "x"}], "]"}]}]}],
          ",", 
         RowBox[{
          RowBox[{"g", "[", 
           RowBox[{"1", ",", "t"}], "]"}], "==", "0"}], ",", 
         RowBox[{
          RowBox[{"g", "[", 
           RowBox[{"0", ",", "t"}], "]"}], "==", 
          RowBox[{
           RowBox[{"x1", "[", "t", "]"}], " ", "theta", " ", 
           RowBox[{"(", 
            RowBox[{"1", "-", 
             RowBox[{"Exp", "[", 
              RowBox[{
               RowBox[{"-", "10000000"}], " ", "t"}], "]"}]}], ")"}]}]}], ",", 
         RowBox[{
          RowBox[{"g", "[", 
           RowBox[{"x", ",", "0"}], "]"}], "==", "0"}]}], "}"}], ",", "g", 
       ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", "1000"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "0", ",", "1"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"gData", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Datatfix", "[", 
           RowBox[{"[", 
            RowBox[{"k", ",", "2"}], "]"}], "]"}], " ", 
          RowBox[{
           RowBox[{"G", "[", 
            RowBox[{"x", ",", 
             RowBox[{"Datatfix", "[", 
              RowBox[{"[", 
               RowBox[{"k", ",", "1"}], "]"}], "]"}]}], "]"}], "/", 
           RowBox[{"(", 
            RowBox[{"x", "*", 
             RowBox[{"(", 
              RowBox[{"1", "-", "x"}], ")"}]}], ")"}]}]}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "1", ",", 
           RowBox[{"Length", "[", "Datatfix", "]"}]}], "}"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "0.001", ",", "0.999", ",", "0.001"}], "}"}]}], 
      "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"averageGData", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"AppendTo", "[", 
     RowBox[{"averageGData", ",", "gData"}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{3.930142532945631*^9, 3.93014288420492*^9},
 CellLabel->"In[21]:=",ExpressionUUID->"12400086-2e52-4b21-b27b-60166dc2c0a9"],

