Inbreeeding_recombination/average_data_check_f.txt\>\"", 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"datas1s", "=", 
    RowBox[{"ReadList", "[", 
     RowBox[{"s1s", ",", 
      RowBox[{"{", 
       RowBox[{"Number", ",", "Number"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
