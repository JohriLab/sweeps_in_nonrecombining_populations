     RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"x21s", "=", 
    RowBox[{"datas1s", "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]",
   "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Data1s", "=", 
    RowBox[{"Transpose", "@", 
     RowBox[{"{", 
      RowBox[{"x11s", ",", " ", 
       RowBox[{"x11s", " ", 
        FractionBox["x21s", "theta"]}]}], "}"}]}]}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
   "Define", " ", "logarithmic", " ", "binning", " ", "and", " ", "smoothing",
     " ", "function"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"smoothDataLog", "[", 
     RowBox[{"data_", ",", "numBins_", ",", "xThreshold_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "filteredData", ",", "bins", ",", "binnedData", ",", "binEdges", ",", 
        "binnedX", ",", "binnedY", ",", "counts", ",", "logMin", ",", 
        "logMax", ",", "logBinEdges"}], "}"}], ",", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
        "Filter", " ", "data", " ", "to", " ", "include", " ", "only", " ", 
         "points", " ", "where", " ", "x"}], ">", "xThreshold"}], "*)"}], 
      RowBox[{
       RowBox[{"filteredData", "=", 
        RowBox[{"Select", "[", 
         RowBox[{"data", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ">", "xThreshold"}], "&"}]}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "Determine", " ", "the", " ", "range", " ", "and", " ", "width", " ", 
         "of", " ", "bins", " ", "for", " ", "filtered", " ", "data"}], 
        "*)"}], 
       RowBox[{"logMin", "=", 
        RowBox[{"Log10", "[", 
         RowBox[{"Min", "[", 
          RowBox[{"filteredData", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"logMax", "=", 
        RowBox[{"Log10", "[", 
         RowBox[{"Max", "[", 
          RowBox[{"filteredData", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"logBinEdges", "=", 
        RowBox[{"Range", "[", 
         RowBox[{"logMin", ",", "logMax", ",", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"logMax", "-", "logMin"}], ")"}], "/", "numBins"}]}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"bins", "=", 
        RowBox[{"10", "^", "logBinEdges"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Initialize", " ", "bins"}], "*)"}], 
       RowBox[{"binnedX", "=", 
        RowBox[{"Table", "[", 
         RowBox[{"0", ",", 
          RowBox[{"{", "numBins", "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"binnedY", "=", 
        RowBox[{"Table", "[", 
         RowBox[{"0", ",", 
          RowBox[{"{", "numBins", "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"counts", "=", 
        RowBox[{"Table", "[", 
         RowBox[{"0", ",", 
          RowBox[{"{", "numBins", "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Bin", " ", "the", " ", "data"}], "*)"}], 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", "binIndex", "}"}], ",", 
           RowBox[{
            RowBox[{"binIndex", "=", 
             RowBox[{
              RowBox[{"Floor", "[", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"Log10", "[", 
                   RowBox[{"filteredData", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "1"}], "]"}], "]"}], "]"}], "-", 
                  "logMin"}], ")"}], "/", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"logMax", "-", "logMin"}], ")"}], "/", "numBins"}],
                  ")"}]}], "]"}], "+", "1"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"binIndex", ">", "0"}], "&&", 
               RowBox[{"binIndex", "<=", "numBins"}]}], ",", 
              RowBox[{
               RowBox[{
                RowBox[{"binnedX", "[", 
                 RowBox[{"[", "binIndex", "]"}], "]"}], "+=", 
                RowBox[{"filteredData", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", ",", "1"}], "]"}], "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"binnedY", "[", 
                 RowBox[{"[", "binIndex", "]"}], "]"}], "+=", 
                RowBox[{"filteredData", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", ",", "2"}], "]"}], "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"counts", "[", 
                 RowBox[{"[", "binIndex", "]"}], "]"}], "+=", "1"}], ";"}]}], 
             "]"}]}]}], "]"}], ",", 
         RowBox[{"{", 
