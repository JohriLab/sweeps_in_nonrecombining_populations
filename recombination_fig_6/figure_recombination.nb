     FractionBox["N1", 
      RowBox[{"1", "+", "f"}]]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"theta", "=", 
     RowBox[{"4", " ", "N1", " ", "mu", " ", "L"}]}], ";", " ", 
    RowBox[{"(*", " ", 
     RowBox[{"theta", "=", " ", 
      RowBox[{"2", " ", "N", " ", "mu"}]}], " ", "*)"}], 
    "\[IndentingNewLine]", 
