          RowBox[{"Min", "[", 
           RowBox[{"filteredData", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"logMax", "=", 
         RowBox[{"Log10", "[", 
          RowBox[{"Max", "[", 
           RowBox[{"filteredData", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"logBinEdges", "=", 
         RowBox[{"Range", "[", 
          RowBox[{"logMin", ",", "logMax", ",", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"logMax", "-", "logMin"}], ")"}], "/", "numBins"}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"bins", "=", 
         RowBox[{"10", "^", "logBinEdges"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
