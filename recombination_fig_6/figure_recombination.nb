      " ", "zero", " ", "and", " ", "x11s", " ", "is", " ", "0", " ", "or", 
     " ", "1"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"filteredData", "=", 
     RowBox[{"Select", "[", 
