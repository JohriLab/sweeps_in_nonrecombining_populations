         RowBox[{"\"\<Simulations\>\"", ",", " ", "\"\<Diffusion\>\""}], 
         "}"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"a2s", "=", 
     RowBox[{"LogLogPlot", "[", 
      RowBox[{"1", ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "0", ",", "1"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"Show", "[", 
    RowBox[{"a1s", ",", "a2s"}], "]"}], "\[IndentingNewLine]"}]}]], "Input",
