    RowBox[{"L", "=", "10000"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"theta", "=", 
     RowBox[{"4", " ", "N1", " ", "mu", " ", "L"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
