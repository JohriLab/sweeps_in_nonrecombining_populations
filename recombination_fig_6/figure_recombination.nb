        RowBox[{"{", "\"\<Simulations\>\"", "}"}]}], ",", 
       RowBox[{"PlotMarkers", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"\"\<\[FilledCircle]\>\"", ",", "10"}], "}"}]}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"Show", "[", "a1s", "]"}], "\n"}]}]], "Input",
