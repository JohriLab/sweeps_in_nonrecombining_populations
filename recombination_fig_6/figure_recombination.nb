       RowBox[{
        RowBox[{"xMinThreshold", "<", 
         RowBox[{"#", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "<", "xMaxThreshold"}], "&"}]}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"upperPart", "=", 
     RowBox[{"Select", "[", 
      RowBox[{"upperSmoothedData", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ">=", "xMaxThreshold"}], "&"}]}], 
      "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Combine", " ", "all", " ", "parts"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"combinedData", "=", 
     RowBox[{"Join", "[", 
