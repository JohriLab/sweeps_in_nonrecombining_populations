        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "-", "h"}], ")"}], " ", "f"}]}], ")"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sb", "=", " ", 
     RowBox[{"s", " ", 
      RowBox[{"(", 
       RowBox[{"1", "-", " ", 
