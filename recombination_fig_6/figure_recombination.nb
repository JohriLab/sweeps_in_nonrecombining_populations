         RowBox[{"\"\<Simulations\>\"", ",", " ", "\"\<Diffusion\>\""}], 
         "}"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"a2s", "=", 
