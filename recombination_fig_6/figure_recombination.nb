         RowBox[{"0", ",", "t"}], "]"}], "==", 
        RowBox[{
         RowBox[{"x1", "[", "t", "]"}], " ", "theta", " ", 
         RowBox[{"(", 
          RowBox[{"1", "-", 
           RowBox[{"Exp", "[", 
            RowBox[{
             RowBox[{"-", "10000000"}], " ", "t"}], "]"}]}], ")"}]}]}], ",", 
       RowBox[{
        RowBox[{"g", "[", 
         RowBox[{"x", ",", "0"}], "]"}], "==", "0"}]}], "}"}], ",", "g", ",", 
     
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "100"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "1"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"gData", "=", 
    RowBox[{"Table", "[", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"G", "[", 
        RowBox[{"x", ",", "100"}], "]"}], "/", 
       RowBox[{"(", 
        RowBox[{"x", "*", 
         RowBox[{"(", 
          RowBox[{"1", "-", "x"}], ")"}]}], ")"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "0.001", ",", "0.999", ",", "0.001"}], "}"}]}], 
     "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"averageGData", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"AppendTo", "[", 
   RowBox[{"averageGData", ",", "gData"}], "]"}], 
  ";"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.934482363690556*^9, 3.9344823729072733`*^9}, {
  3.934482408285797*^9, 3.934482450818836*^9}, {3.934482508380275*^9, 
  3.934482523148488*^9}},
