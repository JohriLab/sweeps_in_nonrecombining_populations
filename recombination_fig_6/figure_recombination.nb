Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"N1", "=", "1000"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"mu", "=", 
     RowBox[{"10", "^", 
      RowBox[{"-", "7"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"L", "=", "1000000"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"theta", "=", 
     RowBox[{"4", " ", "N1", " ", "mu", " ", "L"}]}], ";", 
    RowBox[{"(*", 
     RowBox[{"theta", "=", 
      RowBox[{"4", " ", "N", " ", "mu"}]}], "*)"}], 
    RowBox[{"s1s", "=", 
     RowBox[{
     "OpenRead", "[", 
      "\"\</Users/user/Desktop/Slim_programs/Sel_sfs_independent/Sweeps_\
project/time_dependent/Ns_100/t_100/average_data_t_100_recombination_0.01_\
more_loci.txt\>\"", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"datas1s", "=", 
     RowBox[{"ReadList", "[", 
      RowBox[{"s1s", ",", 
       RowBox[{"{", 
        RowBox[{"Number", ",", "Number"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Close", "[", "s1s", "]"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"x11s", "=", 
     RowBox[{"datas1s", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"x21s", "=", 
     RowBox[{"datas1s", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Filter", " ", "out", " ", "points", " ", "where", " ", "x21s", " ", "is",
      " ", "zero", " ", "and", " ", "x11s", " ", "is", " ", "0", " ", "or", 
     " ", "1"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"filteredData", "=", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"x11s", ",", "x21s"}], "}"}], "]"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "!=", "0"}], "&&", 
         RowBox[{"0", "<", 
          RowBox[{"#", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "<", "1"}]}], "&"}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"x11sFiltered", "=", 
     RowBox[{"filteredData", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"x21sFiltered", "=", 
     RowBox[{"filteredData", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Data1s", "=", 
     RowBox[{"Transpose", "@", 
      RowBox[{"{", 
       RowBox[{"x11sFiltered", ",", 
        RowBox[{"x11sFiltered", " ", 
         RowBox[{"x21sFiltered", "/", "theta"}]}]}], "}"}]}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Generate", " ", "100", " ", "logarithmically", " ", "spaced", " ", 
     "indices", " ", "within", " ", "the", " ", "filtered", " ", "range"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"logIndices", "=", 
     RowBox[{"Round", "[", 
      RowBox[{"Exp", "[", 
       RowBox[{"Range", "[", 
        RowBox[{
         RowBox[{"Log", "[", "1", "]"}], ",", 
         RowBox[{"Log", "[", 
          RowBox[{"Length", "[", "x11sFiltered", "]"}], "]"}], ",", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Log", "[", 
             RowBox[{"Length", "[", "x11sFiltered", "]"}], "]"}], "-", 
            RowBox[{"Log", "[", "1", "]"}]}], ")"}], "/", "79"}]}], "]"}], 
       "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Select", " ", "the", " ", "corresponding", " ", "points"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"selectedData", "=", 
     RowBox[{"Data1s", "[", 
      RowBox[{"[", "logIndices", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]",
    "\n", 
   RowBox[{"(*", 
    RowBox[{"Plot", " ", "the", " ", "selected", " ", "points"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"a1s", "=", 
     RowBox[{"ListLogLogPlot", "[", 
      RowBox[{"selectedData", ",", 
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{
         "\"\<x\>\"", ",", 
          "\"\<f(x,\\!\\(\\*SubscriptBox[\\(t\\), \
\\(f\\)]\\))/\\!\\(\\*SubscriptBox[\\(f\\), \\(neu\\)]\\)\>\""}], "}"}]}], 
       ",", 
