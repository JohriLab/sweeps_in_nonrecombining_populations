initialize() 
{
         initializeMutationRate(1e-6);
         initializeMutationType("m1", 0.5, "f", 0.0);
         initializeMutationType("m2", 0.5, "f", 0.1);  // introduced mutation
         initializeGenomicElementType("g1", m1, 1.0);
         initializeGenomicElement(g1, 0, 10000);
         initializeRecombinationRate(0);
         m1.mutationStackPolicy = "f";
}
1 early() 
{
         // save this run's identifier, used to save and restore
         defineConstant("simID", getSeed());
         sim.addSubpop("p1", 1000);
         p1.setSelfingRate(0.9);
}
// burn in till 10000
10 late() 
{
        p1.setSelfingRate(0.9);
        // save the state of the simulation
        sim.outputFull(tempdir() + "slim_" + simID + ".txt");
        // introduce the sweep mutation
        target = sample(p1.genomes, 1);
        target.addNewDrawnMutation(m2, 1); // only one mutation is added
}
10:100000 late() 
{
        p1.setSelfingRate(0.9);
        if (sim.countOfMutationsOfType(m2) == 0)
        {
          fixed = (sum(sim.substitutions.mutationType == m2) == 1);
          if (fixed) 
          {
            cat(simID + ": FIXED\n");
            sim.outputFull();
            // sample 20 outputs genomes
            
            sim.simulationFinished();
          }
          else
          {
            cat(simID + ": LOST – RESTARTING\n");
            // go back to tick 10000
            sim.readFromPopulationFile(tempdir() + "slim_" + simID + ".txt");
            // start a newly seeded run
            setSeed(rdunif(1, 0, asInteger(2^62) - 1));
            p1.setSelfingRate(0.9);
            // re-introduce the sweep mutation
            target = sample(p1.genomes, 1);
            target.addNewDrawnMutation(m2, 1);
          }
        } 
}