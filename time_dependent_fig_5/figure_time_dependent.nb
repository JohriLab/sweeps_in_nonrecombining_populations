        RowBox[{"{", 
         RowBox[{"Brown", ",", 
          RowBox[{"Thickness", "[", "0.003", "]"}]}], "}"}]}]}], "]"}]}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Show", " ", "both", " ", "plots"}], "*)"}], "\n", 
   RowBox[{"Show", "[", "a1sInterpolated", "]"}], 
