Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"N1", "=", "500"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"s", "=", "0.05"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"theta", "=", "0.1"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
    "trajDirectory", "=", 
     "\"\</Users/user/Documents/UNC_work/project_1/C_programs/sub_population/\
Ns_25/\>\""}], ";"}], "\n", 
   RowBox[{
    RowBox[{"averagehet", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Do", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Processing file number: \>\"", ",", "i"}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"trajFile", "=", 
        RowBox[{"OpenRead", "[", 
         RowBox[{"StringJoin", "[", 
          RowBox[{"trajDirectory", ",", "\"\<traj_\>\"", ",", 
           RowBox[{"ToString", "[", "i", "]"}], ",", "\"\<.txt\>\""}], "]"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"trajData", "=", 
        RowBox[{"ReadList", "[", 
         RowBox[{"trajFile", ",", 
          RowBox[{"{", 
           RowBox[{"Number", ",", "Number"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"trajInterpolation", "=", 
        RowBox[{"Interpolation", "[", "trajData", "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"G", "=", 
        RowBox[{"NDSolveValue", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"D", "[", 
              RowBox[{
               RowBox[{"g", "[", 
                RowBox[{"x", ",", "t"}], "]"}], ",", "t"}], "]"}], "==", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"x", " ", 
                 RowBox[{"(", 
                  RowBox[{"1", "-", "x"}], ")"}]}], ")"}], "/", 
               RowBox[{"(", 
                RowBox[{"2", " ", "N1", "*", 
                 RowBox[{"trajInterpolation", "[", "t", "]"}]}], ")"}]}], " ", 
              RowBox[{"D", "[", 
               RowBox[{
                RowBox[{"g", "[", 
                 RowBox[{"x", ",", "t"}], "]"}], ",", "x", ",", "x"}], 
               "]"}]}]}], ",", 
            RowBox[{
             RowBox[{"g", "[", 
              RowBox[{"1", ",", "t"}], "]"}], "==", "0"}], ",", 
            RowBox[{
             RowBox[{"g", "[", 
              RowBox[{"0", ",", "t"}], "]"}], "==", 
             RowBox[{
              RowBox[{"trajInterpolation", "[", "t", "]"}], " ", "theta", " ", 
              RowBox[{"(", 
               RowBox[{"1", "-", 
                RowBox[{"Exp", "[", 
                 RowBox[{
                  RowBox[{"-", "10000000"}], " ", "t"}], "]"}]}], ")"}]}]}], 
            ",", 
            RowBox[{
             RowBox[{"g", "[", 
              RowBox[{"x", ",", "0"}], "]"}], "==", "0"}]}], "}"}], ",", "g", 
          ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", "0", ",", "600"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", "0", ",", "1"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"gData", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"NIntegrate", "[", 
           RowBox[{
            RowBox[{"G", "[", 
             RowBox[{"x", ",", "tvalue"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"x", ",", "0.01", ",", "0.99"}], "}"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"tvalue", ",", "0", ",", "200"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"AppendTo", "[", 
        RowBox[{"averagehet", ",", "gData"}], "]"}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"Close", "[", "trajFile", "]"}], ";"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", "100"}], "}"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"averageHet", "=", 
     RowBox[{"Mean", "[", "averagehet", "]"}]}], ";"}], "\[IndentingNewLine]",
    "\n", 
   RowBox[{
    RowBox[{"xaxis", "=", 
     RowBox[{"Table", "[", 
      RowBox[{"t", ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", "200", ",", "1"}], "}"}]}], "]"}]}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"ListPlot", "[", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"xaxis", ",", "averageHet"}], "}"}], "]"}], ",", 
     RowBox[{"Frame", "->", "True"}], ",", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<x\>\"", ",", "\"\<Average gData\>\""}], "}"}]}], ",", 
     RowBox[{"FrameStyle", "->", 
      RowBox[{"Directive", "[", 
       RowBox[{
        RowBox[{"Thickness", "[", "0.005", "]"}], ",", "Black"}], "]"}]}]}], 
    "]"}]}]}]], "Input",
