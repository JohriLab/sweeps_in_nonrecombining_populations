Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Data1s", "=", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"xaxis", ",", 
        RowBox[{"xaxis", " ", 
         FractionBox["averageGData1", "theta"]}]}], "}"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Define", " ", "logarithmic", " ", "binning", " ", "and", " ", 
     "smoothing", " ", "function"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"smoothDataLog", "[", 
      RowBox[{"data_", ",", "numBins_", ",", "xThreshold_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "filteredData", ",", "bins", ",", "binnedData", ",", "binEdges", ",", 
         "binnedX", ",", "binnedY", ",", "counts", ",", "logMin", ",", 
         "logMax", ",", "logBinEdges"}], "}"}], ",", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
         "Filter", " ", "data", " ", "to", " ", "include", " ", "only", " ", 
          "points", " ", "where", " ", "x"}], ">", "xThreshold"}], "*)"}], 
       RowBox[{
        RowBox[{"filteredData", "=", 
         RowBox[{"Select", "[", 
          RowBox[{"data", ",", 
           RowBox[{
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ">", "xThreshold"}], "&"}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "Determine", " ", "the", " ", "range", " ", "and", " ", "width", " ",
           "of", " ", "bins", " ", "for", " ", "filtered", " ", "data"}], 
         "*)"}], 
        RowBox[{"logMin", "=", 
         RowBox[{"Log10", "[", 
          RowBox[{"Min", "[", 
           RowBox[{"filteredData", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"logMax", "=", 
         RowBox[{"Log10", "[", 
          RowBox[{"Max", "[", 
           RowBox[{"filteredData", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"logBinEdges", "=", 
         RowBox[{"Range", "[", 
          RowBox[{"logMin", ",", "logMax", ",", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"logMax", "-", "logMin"}], ")"}], "/", "numBins"}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"bins", "=", 
         RowBox[{"10", "^", "logBinEdges"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Initialize", " ", "bins"}], "*)"}], 
        RowBox[{"binnedX", "=", 
         RowBox[{"Table", "[", 
          RowBox[{"0", ",", 
           RowBox[{"{", "numBins", "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"binnedY", "=", 
         RowBox[{"Table", "[", 
          RowBox[{"0", ",", 
           RowBox[{"{", "numBins", "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"counts", "=", 
         RowBox[{"Table", "[", 
          RowBox[{"0", ",", 
           RowBox[{"{", "numBins", "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Bin", " ", "the", " ", "data"}], "*)"}], 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{"Module", "[", 
           RowBox[{
            RowBox[{"{", "binIndex", "}"}], ",", 
            RowBox[{
             RowBox[{"binIndex", "=", 
              RowBox[{
               RowBox[{"Floor", "[", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"Log10", "[", 
                    RowBox[{"filteredData", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "1"}], "]"}], "]"}], "]"}], "-", 
                   "logMin"}], ")"}], "/", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"logMax", "-", "logMin"}], ")"}], "/", 
                   "numBins"}], ")"}]}], "]"}], "+", "1"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"binIndex", ">", "0"}], "&&", 
                RowBox[{"binIndex", "<=", "numBins"}]}], ",", 
               RowBox[{
                RowBox[{
                 RowBox[{"binnedX", "[", 
                  RowBox[{"[", "binIndex", "]"}], "]"}], "+=", 
                 RowBox[{"filteredData", "[", 
                  RowBox[{"[", 
                   RowBox[{"i", ",", "1"}], "]"}], "]"}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"binnedY", "[", 
                  RowBox[{"[", "binIndex", "]"}], "]"}], "+=", 
                 RowBox[{"filteredData", "[", 
                  RowBox[{"[", 
                   RowBox[{"i", ",", "2"}], "]"}], "]"}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"counts", "[", 
                  RowBox[{"[", "binIndex", "]"}], "]"}], "+=", "1"}], ";"}]}],
               "]"}]}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"Length", "[", "filteredData", "]"}]}], "}"}]}], "]"}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "Calculate", " ", "mean", " ", "values", " ", "for", " ", "each", 
          " ", "bin"}], "*)"}], 
        RowBox[{"binnedData", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"counts", "[", 
               RowBox[{"[", "i", "]"}], "]"}], ">", "0"}], ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{
                RowBox[{"binnedX", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "/", 
                RowBox[{"counts", "[", 
                 RowBox[{"[", "i", "]"}], "]"}]}], ",", 
               RowBox[{
                RowBox[{"binnedY", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "/", 
                RowBox[{"counts", "[", 
                 RowBox[{"[", "i", "]"}], "]"}]}]}], "}"}], ",", "Nothing"}], 
            "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "numBins"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Return", " ", "the", " ", "smoothed", " ", "data"}], "*)"}],
         "binnedData"}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Apply", " ", "the", " ", "smoothing", " ", "function", " ", "to", " ", 
     "your", " ", "data"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"numBins", "=", "100"}], ";", 
    RowBox[{"(*", 
     RowBox[{
     "Adjust", " ", "the", " ", "number", " ", "of", " ", "bins", " ", "as", 
      " ", "needed"}], "*)"}], 
    RowBox[{"xThreshold", "=", "0.0001"}], ";", 
    RowBox[{"(*", 
     RowBox[{"Threshold", " ", "for", " ", "binning"}], "*)"}], 
    RowBox[{"smoothedData", "=", 
     RowBox[{"smoothDataLog", "[", 
      RowBox[{"Data1s", ",", "numBins", ",", "xThreshold"}], "]"}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Separate", " ", "data", " ", "into", " ", "two", " ", 
     RowBox[{"parts", ":", 
      RowBox[{"original", " ", "part", " ", 
       RowBox[{"(", 
        RowBox[{"x", "<=", "0.5"}], ")"}], " ", "and", " ", "smoothed", " ", 
       "part", " ", 
       RowBox[{"(", 
        RowBox[{"x", ">", "0.5"}], ")"}]}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"originalPart", "=", 
     RowBox[{"Select", "[", 
      RowBox[{"Data1s", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "<=", "xThreshold"}], "&"}]}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"smoothedPart", "=", 
     RowBox[{"Select", "[", 
      RowBox[{"smoothedData", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ">", "xThreshold"}], "&"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Combine", " ", "original", " ", "and", " ", "smoothed", " ", "parts"}], 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"combinedData", "=", 
     RowBox[{"Join", "[", 
      RowBox[{"originalPart", ",", "smoothedPart"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"interpolation", "=", 
     RowBox[{"Interpolation", "[", "combinedData", "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Plot", " ", "the", " ", "original", " ", "and", " ", "combined", " ", 
     "data"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"a1sOriginal", "=", 
     RowBox[{"ListLogLogPlot", "[", 
      RowBox[{
       RowBox[{"{", "Data1s", "}"}], ",", 
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<x\>\"", ",", "\"\<Distribution of SFS\>\""}], "}"}]}], 
       ",", 
       RowBox[{"FrameStyle", "->", 
        RowBox[{"Thickness", "[", ".003", "]"}]}], ",", 
       RowBox[{"FrameTicks", "->", "Automatic"}], ",", 
       RowBox[{"LabelStyle", "->", 
        RowBox[{"Directive", "[", 
         RowBox[{"Black", ",", "Bold", ",", "Medium"}], "]"}]}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", "Blue", "}"}]}], ",", 
       RowBox[{"PlotLegends", "->", 
        RowBox[{"{", "\"\<Original Data\>\"", "}"}]}], ",", 
       RowBox[{"PlotRange", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0.001", ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0.01", ",", "10000"}], "}"}]}], "}"}]}]}], "]"}]}], ";"}],
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"a1sInterpolated", "=", 
     RowBox[{"LogLogPlot", "[", 
      RowBox[{
       RowBox[{"interpolation", "[", "x", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"Min", "[", 
          RowBox[{"combinedData", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}], ",", 
         RowBox[{"Max", "[", 
          RowBox[{"combinedData", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}]}], "}"}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", 
         RowBox[{"RGBColor", "[", 
          RowBox[{"1.", ",", "0.06", ",", "0.09"}], "]"}], " ", "}"}]}], ",", 
       
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         StyleBox[
          RowBox[{
          "\"\<x\>\"", ",", 
           "\"\<f(x,\!\(\*SubscriptBox[\(t\), \
\(f\)]\))/\!\(\*SubscriptBox[\(f\), \(0\)]\)\>\""}],
          FontSlant->"Italic"], "}"}]}], ",", 
       RowBox[{"FrameStyle", "->", 
        RowBox[{"Thickness", "[", ".003", "]"}]}], ",", 
       RowBox[{"FrameTicks", "->", "Automatic"}], ",", 
       RowBox[{"LabelStyle", "->", 
        RowBox[{"Directive", "[", 
         RowBox[{"Black", ",", "Bold", ",", "Medium"}], "]"}]}], ",", 
       RowBox[{"PlotRange", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0.0001", ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0.01", ",", "1"}], "}"}]}], "}"}]}]}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"a1sCombined", "=", 
     RowBox[{"ListLogLogPlot", "[", 
      RowBox[{
       RowBox[{"{", "combinedData", "}"}], ",", 
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         StyleBox[
          RowBox[{
          "\"\<x\>\"", ",", 
           "\"\<f(x,\!\(\*SubscriptBox[\(t\), \
\(f\)]\))/\!\(\*SubscriptBox[\(f\), \(0\)]\)\>\""}],
          FontSlant->"Italic"], "}"}]}], ",", 
       RowBox[{"FrameStyle", "->", 
        RowBox[{"Thickness", "[", ".003", "]"}]}], ",", 
       RowBox[{"FrameTicks", "->", "Automatic"}], ",", 
       RowBox[{"LabelStyle", "->", 
        RowBox[{"Directive", "[", 
         RowBox[{"Black", ",", "Bold", ",", "Medium"}], "]"}]}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", "Red", "}"}]}], ",", 
       RowBox[{"PlotLegends", "->", 
        RowBox[{"{", "\"\<h=0.8\>\"", "}"}]}], ",", 
