Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"N1", "=", "1000"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"s0", "=", "0.05"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"h", "=", "0.5"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"x0", "=", 
     RowBox[{"1", "/", 
      RowBox[{"(", 
       RowBox[{"2", " ", "N1"}], ")"}]}]}], ";"}], "\n", "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"si", "[", "t_", "]"}], ":=", "s0"}], ";"}], 
   "\[IndentingNewLine]", "\n", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"taui", "[", "t_", "]"}], ":=", 
     RowBox[{
      RowBox[{"taui", "[", "t", "]"}], "=", 
      RowBox[{"h", "*", 
       RowBox[{"NIntegrate", "[", 
        RowBox[{
         RowBox[{"si", "[", "t1", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"t1", ",", "0", ",", "t"}], "}"}]}], "]"}]}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", "\n", 
   RowBox[{
    RowBox[{"pf1", "=", 
     RowBox[{"2", "/", 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"NIntegrate", "[", 
         RowBox[{
          RowBox[{"Exp", "[", 
           RowBox[{"-", 
            RowBox[{"taui", "[", "t", "]"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", "0", ",", "Infinity"}], "}"}]}], "]"}]}], 
       ")"}]}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"C1", "=", 
     RowBox[{"2", " ", "N1", " ", "pf1"}]}], ";"}], "\[IndentingNewLine]", 
