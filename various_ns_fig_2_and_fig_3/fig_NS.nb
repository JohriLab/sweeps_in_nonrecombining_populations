       RowBox[{"LabelStyle", "->", 
        RowBox[{"Directive", "[", 
         RowBox[{"Black", ",", "Bold", ",", "Medium"}], "]"}]}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", "Red", "}"}]}], ",", 
       RowBox[{"PlotLegends", "->", 
