Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"N1", "=", "1000"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"s0", "=", "0.01"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"h", "=", "0.5"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"x0", "=", 
     RowBox[{"1", "/", 
      RowBox[{"(", 
       RowBox[{"2", " ", "N1"}], ")"}]}]}], ";"}], "\n", "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"si", "[", "t_", "]"}], ":=", "s0"}], ";"}], 
   "\[IndentingNewLine]", "\n", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"taui", "[", "t_", "]"}], ":=", 
     RowBox[{
      RowBox[{"taui", "[", "t", "]"}], "=", 
      RowBox[{"h", "*", 
       RowBox[{"NIntegrate", "[", 
        RowBox[{
         RowBox[{"si", "[", "t1", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"t1", ",", "0", ",", "t"}], "}"}]}], "]"}]}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", "\n", 
   RowBox[{
    RowBox[{"pf1", "=", 
     RowBox[{"2", "/", 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"NIntegrate", "[", 
         RowBox[{
          RowBox[{"Exp", "[", 
           RowBox[{"-", 
            RowBox[{"taui", "[", "t", "]"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", "0", ",", "Infinity"}], "}"}]}], "]"}]}], 
       ")"}]}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"C1", "=", 
     RowBox[{"2", " ", "N1", " ", "pf1"}]}], ";"}], "\[IndentingNewLine]", 
   "\n", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"B", "[", "Te_", "]"}], ":=", 
     RowBox[{
      RowBox[{"B", "[", "Te", "]"}], "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"2", " ", "N1"}], ")"}], "/", 
       RowBox[{"NIntegrate", "[", 
        RowBox[{
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", "-", "h"}], ")"}], "/", "h"}], " ", 
           RowBox[{"taui", "[", "t", "]"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "0", ",", "Te"}], "}"}]}], "]"}]}]}]}], ";"}], 
   "\n", "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"pdfsd", "[", "Te_", "]"}], ":=", 
     RowBox[{
      RowBox[{"pdfsd", "[", "Te", "]"}], "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "/", 
         RowBox[{"(", 
          RowBox[{"2", " ", "N1"}], ")"}]}], ")"}], " ", "C1", " ", 
       RowBox[{
        RowBox[{"B", "[", "Te", "]"}], "^", "2"}], " ", 
       RowBox[{"Exp", "[", 
        RowBox[{"taui", "[", "Te", "]"}], "]"}], " ", "2", " ", 
       RowBox[{"BesselK", "[", 
        RowBox[{"0", ",", 
         RowBox[{"2", " ", 
          RowBox[{"Sqrt", "[", 
           RowBox[{
            RowBox[{"B", "[", "Te", "]"}], " ", "C1"}], "]"}]}]}], 
        "]"}]}]}]}], ";"}], "\n", "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"pdfgenh", "[", "Te_", "]"}], ":=", 
     RowBox[{
      RowBox[{"pdfgenh", "[", "Te", "]"}], "=", 
      RowBox[{
       RowBox[{"h", "/", 
        RowBox[{"(", 
         RowBox[{"1", "-", "h"}], ")"}]}], " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"C1", " ", 
          RowBox[{
           RowBox[{"B", "[", "Te", "]"}], "^", "2"}]}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{"2", " ", "N1"}], ")"}]}], " ", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "-", "h"}], ")"}], "/", "h"}], " ", 
         RowBox[{"taui", "[", "Te", "]"}]}], "]"}], "*", 
       RowBox[{"NIntegrate", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"q", "^", 
           RowBox[{"(", 
            RowBox[{"-", 
             RowBox[{"(", 
              RowBox[{"h", "/", 
               RowBox[{"(", 
                RowBox[{"1", "-", "h"}], ")"}]}], ")"}]}], ")"}]}], " ", 
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", 
             RowBox[{"B", "[", "Te", "]"}]}], " ", "q"}], "]"}], " ", 
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", "C1"}], " ", 
            RowBox[{"q", "^", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", "h"}], "/", 
               RowBox[{"(", 
                RowBox[{"1", "-", "h"}], ")"}]}], ")"}]}]}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"q", ",", "0", ",", "Infinity"}], "}"}], ",", 
         RowBox[{"MaxRecursion", "->", "20"}]}], "]"}]}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", "\n", 
   RowBox[{"a3", "=", 
    RowBox[{"Plot", "[", 
     RowBox[{
      RowBox[{"pdfgenh", "[", "t", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "1", ",", "3500"}], "}"}], ",", 
      RowBox[{"PlotRange", "->", "All"}], ",", 
      RowBox[{"PlotPoints", "->", "50"}]}], "]"}]}]}]}]], "Input",
 CellChangeTimes->{3.929718266916621*^9, 3.929718299415448*^9},
 CellLabel->"In[1]:=",ExpressionUUID->"eb3783a6-1603-4192-a3ab-3482274b042c"],

