       RowBox[{"Directive", "[", 
        RowBox[{"Black", ",", "Bold", ",", "Medium"}], "]"}]}], ",", 
      RowBox[{"PlotStyle", "->", 
       RowBox[{"{", "Red", "}"}]}], ",", 
      RowBox[{"PlotLegends", "->", 
       RowBox[{"{", "\"\<h=0.8\>\"", "}"}]}], ",", 
      RowBox[{"PlotRange", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0.001", ",", "1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"0.003", ",", "1"}], "}"}]}], "}"}]}], 
      RowBox[{"(*", 
       RowBox[{",", " ", 
        RowBox[{"PlotMarkers", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"\"\<\[EmptyCircle]\>\"", ",", "10"}], "}"}]}]}], "*)"}], 
      ",", " ", 
      RowBox[{"Joined", "->", "True"}]}], "]"}]}], ";"}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Show", " ", "both", " ", "plots"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", "a1sInterpolated", "]"}]}], "Input",
