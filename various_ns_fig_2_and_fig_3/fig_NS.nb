       RowBox[{"PlotLegends", "->", 
        RowBox[{"{", "\"\<Original Data\>\"", "}"}]}], ",", 
       RowBox[{"PlotRange", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0.001", ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0.01", ",", "10000"}], "}"}]}], "}"}]}]}], "]"}]}], ";"}],
    "\n", "\[IndentingNewLine]", 
   RowBox[{
