       RowBox[{"Black", ",", "Bold", ",", "Medium"}], "]"}]}], ",", 
     RowBox[{"PlotRange", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0.001", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0.004", ",", "1"}], "}"}]}], "}"}]}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"a1sCombined", "=", 
    RowBox[{"ListLogLogPlot", "[", 
     RowBox[{
      RowBox[{"{", "combinedData", "}"}], ",", 
      RowBox[{"Frame", "->", "True"}], ",", 
      RowBox[{"FrameLabel", "->", 
       RowBox[{"{", 
        StyleBox[
         RowBox[{
         "\"\<x\>\"", ",", 
          "\"\<f(x,\!\(\*SubscriptBox[\(t\), \(f\)]\))/\!\(\*SubscriptBox[\(f\
\), \(0\)]\)\>\""}],
         FontSlant->"Italic"], "}"}]}], ",", 
      RowBox[{"FrameStyle", "->", 
       RowBox[{"Thickness", "[", ".003", "]"}]}], ",", 
      RowBox[{"FrameTicks", "->", "Automatic"}], ",", 
